{% liquid
  assign has_video = false
  if section.settings.media_type == 'video' and section.settings.video != blank
    assign has_video = true
  endif
%}
<section class="b2b-section{% if section.settings.compact %} ev-page-hero--compact{% endif %} b2b-section--{{ section.settings.color_scheme }}">
  <div class="container b2b-split b2b-hero{% if section.settings.show_image == false %} b2b-split--text-only{% elsif section.settings.image == blank and has_video == false and request.design_mode == false %} b2b-split--text-only{% endif %}">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      <div class="b2b-rte">{{ section.settings.text }}</div>
      <div class="b2b-actions">
        {% if section.settings.button_label != blank and section.settings.button_link != blank %}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="btn btn--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
      </div>
    </div>
    {% if section.settings.show_image %}{% render 'b2b-image', media_type: section.settings.media_type, video: section.settings.video, poster: section.settings.poster, photo: section.settings.image, alt: section.settings.image_alt, title: section.settings.heading, note: section.settings.photo_note, eager: true %}{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "B2B page hero",
  "tag": "section",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Elma Vada · Dallas, Texas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Personalized gifts and engraving for the people behind your business.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Include image or video",
      "default": true
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video — play on click, muted"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video — no autoplay or sound"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Video cover (optional)",
      "info": "Uses the video's preview image if empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description (alt)"
    },
    {
      "type": "textarea",
      "id": "photo_note",
      "label": "Photo brief (editor only)",
      "default": "Реальное фото подарка или производства, без текста поверх изображения. Рекомендуется 1600 × 1600 px."
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "navy",
          "label": "Dark"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "cream"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "View Our Work"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact intro (forms)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "B2B page hero"
    }
  ]
}
{% endschema %}
