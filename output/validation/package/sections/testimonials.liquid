{% assign review_count = 0 %}
{% for block in section.blocks %}{% if block.settings.quote != blank and block.settings.name != blank %}{% assign review_count = review_count | plus: 1 %}{% endif %}{% endfor %}
{%- if review_count > 0 or request.design_mode and section.blocks.size > 0 -%}
<section class="section bg-beige" aria-label="Customer testimonials">
  <div class="container" style="max-width: 1100px;">
    <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem;">
      <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="section-subtitle" style="font-size: 1.125rem; color: var(--color-text-secondary);">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem;">
      {%- for block in section.blocks -%}
        {% if block.settings.quote != blank and block.settings.name != blank %}
        <figure {{ block.shopify_attributes }} style="margin: 0; background: #fff; border: 1px solid #eaeaea; padding: 2rem; border-radius: 4px;">
          <blockquote style="margin: 0 0 1.25rem; color: var(--color-navy); font-family: var(--font-heading); font-size: 1.25rem; line-height: 1.45;">“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption style="color: var(--color-text-secondary); font-size: .95rem;">{{ block.settings.name | escape }}{% if block.settings.company != blank %} · {{ block.settings.company | escape }}{% endif %}{% if block.settings.source_url != blank %}<br><a href="{{ block.settings.source_url }}" target="_blank" rel="noopener" style="color: var(--color-gold); font-weight: 600;">{{ section.settings.source_label | escape }} →</a>{% endif %}</figcaption>
        </figure>
        {% elsif request.design_mode %}<p class="b2b-editor-note" {{ block.shopify_attributes }}>Добавьте настоящий отзыв и имя автора с разрешением на публикацию.</p>{% endif %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{"name":"Customer testimonials","settings":[{"type":"text","id":"heading","label":"Heading","default":"What our customers say"},{"type":"textarea","id":"subheading","label":"Subheading"},{"type":"text","id":"source_label","label":"Source link text","default":"Read the original review"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Review","info":"Use a real review with permission to publish."},{"type":"text","id":"name","label":"Customer name"},{"type":"text","id":"company","label":"Company or role"},{"type":"url","id":"source_url","label":"Original review link"}]}],"max_blocks":6,"presets":[{"name":"Customer testimonials"}]}
{% endschema %}
