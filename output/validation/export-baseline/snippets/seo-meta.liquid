{% liquid
  assign fallback_title = page_title
  assign fallback_description = ''
  case page.handle
    when 'business-solutions'
      assign fallback_title = 'Corporate Gifting Solutions in DFW | Elma Vada'
      assign fallback_description = 'Explore personalized gifts for employees, clients, events and onboarding. Plan your project with our Dallas–Fort Worth engraving team.'
    when 'production-capabilities'
      assign fallback_title = 'Laser Engraving Capabilities in Dallas | Elma Vada'
      assign fallback_description = 'Explore our in-house laser engraving capabilities, materials and production process. Send your artwork and quantity for a project quote.'
    when 'industries'
      assign fallback_title = 'Corporate Gifts by Industry in DFW | Elma Vada'
      assign fallback_description = 'Find personalized gifting ideas for your industry, team and occasion. Discuss quantities, engraving and delivery with our DFW studio.'
    when 'our-work'
      assign fallback_title = 'Personalized Gift Projects & Engraving | Elma Vada'
      assign fallback_description = 'Explore real engraved gift projects, personalized details and production examples. Request a custom mockup for your next corporate gift.'
    when 'about'
      assign fallback_title = 'About Our Dallas Engraving Studio | Elma Vada'
      assign fallback_description = 'Meet the team behind Elma Vada’s personalized corporate gifts. Learn about our Dallas studio, in-house engraving and approach to quality.'
    when 'request-a-quote'
      assign fallback_title = 'Request a Corporate Gift Quote | Elma Vada'
      assign fallback_description = 'Tell us your occasion, quantity and deadline. Share your artwork and request a quote for personalized corporate gifts and laser engraving.'
    when 'corporate-gifts'
      assign fallback_title = 'Personalized Corporate Gifts in DFW | Elma Vada'
      assign fallback_description = 'Personalized gifts for employee recognition, client appreciation and company events. Explore engraved gift ideas and request a free mockup.'
    when 'bulk-orders'
      assign fallback_title = 'Bulk Personalized Gifts & Engraving | Elma Vada'
      assign fallback_description = 'Plan engraved gift orders from 1 to 5,000+ units. Share your quantity, artwork and deadline for a project-specific quote and production timing.'
    when 'branded-merchandise'
      assign fallback_title = 'Personalized Merchandise in Dallas | Elma Vada'
      assign fallback_description = 'Create personalized merchandise with names, messages or your company logo. Explore laser-engraved gifts for teams, clients and events.'
    when 'custom-engraving'
      assign fallback_title = 'Custom Laser Engraving in Dallas | Elma Vada'
      assign fallback_description = 'Request custom laser engraving for gifts, awards and business projects. Discuss materials, artwork and quantities with our Dallas team.'
    when 'promotional-products'
      assign fallback_title = 'Personalized Promotional Gifts in DFW | Elma Vada'
      assign fallback_description = 'Make your next event personal with laser-engraved promotional gifts. Share your logo, quantity and deadline to explore suitable options.'
    when 'faq'
      assign fallback_title = 'Corporate Gift & Engraving FAQs | Elma Vada'
      assign fallback_description = 'Find answers about gift quantities, SVG artwork, mockups, physical samples and turnaround. Learn how to start your engraving project.'
    when 'client-gifting'
      assign fallback_title = 'Personalized Client & Executive Gifts | Elma Vada'
      assign fallback_description = 'Plan thoughtful gifts for clients, partners and executives. Explore engraved gifts, personalization and repeat-order options in DFW.'
    when 'service-awards'
      assign fallback_title = 'Years-of-Service Awards in DFW | Elma Vada'
      assign fallback_description = 'Recognize years of service with personalized engraved awards and gifts. Plan names, dates, quantities and presentation with our team.'
    when 'employee-recognition'
      assign fallback_title = 'Employee Recognition Gifts in DFW | Elma Vada'
      assign fallback_description = 'Celebrate work anniversaries, promotions and retirements with personalized gifts. Explore engraved recognition ideas and a free custom mockup.'
    when 'events-awards'
      assign fallback_title = 'Corporate Event Gifts & Awards in DFW | Elma Vada'
      assign fallback_description = 'Plan personalized speaker gifts, corporate awards and conference gifts. Share your event date and quantity to discuss production and delivery.'
    when 'onboarding'
      assign fallback_title = 'Personalized Employee Onboarding Gifts | Elma Vada'
      assign fallback_description = 'Welcome new hires with personalized gifts and onboarding sets. Discuss engraving, presentation and delivery for your team’s next arrival.'
    when 'milestone-program'
      assign fallback_title = 'Employee Milestone Gifting Program | Elma Vada'
      assign fallback_description = 'Build a repeatable plan for anniversaries and employee milestones. Discuss your gifting calendar, approvals and delivery in a 20-minute audit.'
    when 'free-mockup'
      assign fallback_title = 'Free Corporate Gift Mockup | Elma Vada'
      assign fallback_description = 'See your personalized gift idea before ordering. Share your occasion, quantity and logo to request a free custom engraving mockup.'
    when 'book-a-call'
      assign fallback_title = 'Schedule a Gifting Consultation | Elma Vada'
      assign fallback_description = 'Discuss personalized gifts, quantities and timing with Elma Vada. Request a project call or an in-person consultation in Dallas–Fort Worth.'
  endcase
  assign seo_title = page_title
  assign seo_description = page_description | default: fallback_description
  if request.page_type == 'index'
    assign seo_title = settings.home_seo_title | default: 'Personalized Corporate Gifts in Dallas | Elma Vada'
    assign seo_description = settings.home_seo_description
  elsif request.page_type == 'page' and page_title == page.title
    assign seo_title = fallback_title
  endif
  if seo_title == blank
    assign seo_title = shop.name
  endif
  assign social_photo = page_image | default: settings.social_image | default: settings.business_image
  assign og_type = 'website'
  if request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'product'
    assign og_type = 'product'
  endif
%}
<title>{{ seo_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}</title>
{% if seo_description != blank %}<meta name="description" content="{{ seo_description | strip_html | escape }}">{% endif %}
<meta property="og:site_name" content="{{ settings.business_name | default: shop.name | escape }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{{ seo_description | strip_html | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{{ og_type }}">
<meta name="twitter:card" content="{% if social_photo != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
<meta name="twitter:description" content="{{ seo_description | strip_html | escape }}">
{% if social_photo != blank %}
  <meta property="og:image" content="https:{{ social_photo | image_url: width: 1200 }}">
  <meta property="og:image:width" content="{{ social_photo.width | at_most: 1200 }}">
  <meta property="og:image:alt" content="{{ social_photo.alt | default: seo_title | escape }}">
  <meta name="twitter:image" content="https:{{ social_photo | image_url: width: 1200 }}">
{% endif %}
