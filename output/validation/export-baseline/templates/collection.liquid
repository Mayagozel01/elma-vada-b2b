<section class="section bg-beige" style="padding: 4rem 1rem;"><div class="container">
  <header style="text-align: center; max-width: 760px; margin: 0 auto 3rem;"><h1 class="page-title" style="font-family: var(--font-heading); font-size: clamp(2.5rem, 5vw, 3.5rem); color: var(--color-navy); margin-bottom: 1rem;">{{ collection.title }}</h1>{% if collection.description != blank %}<div style="color: var(--color-text-secondary); line-height: 1.6;">{{ collection.description }}</div>{% endif %}</header>
  {% paginate collection.products by 24 %}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem;">
      {% for product in collection.products %}<article style="background: #fff; border: 1px solid #eaeaea; border-radius: 4px; overflow: hidden; display: flex; flex-direction: column;"><a href="{{ product.url }}">{% if product.featured_image != blank %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" loading="lazy" style="width:100%;height:240px;object-fit:cover;display:block;">{% else %}<div style="height:240px;background:#eaeaea;display:grid;place-items:center;color:#777;">Product photo</div>{% endif %}</a><div style="padding:1.25rem;display:flex;flex-direction:column;flex-grow:1;"><h2 style="font-family:var(--font-heading);font-size:1.35rem;margin:0 0 .5rem;"><a href="{{ product.url }}" style="color:var(--color-navy);text-decoration:none;">{{ product.title }}</a></h2><p style="margin:0 0 1rem;color:var(--color-text-secondary);">{{ product.price | money }}</p><a href="{{ product.url }}" class="btn btn--outline" style="margin-top:auto;border-color:var(--color-navy);color:var(--color-navy);text-align:center;">View product</a></div></article>{% else %}<p>No products are available in this collection yet.</p>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<nav style="display:flex;justify-content:center;gap:1rem;margin-top:3rem;">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next</a>{% endif %}</nav>{% endif %}
  {% endpaginate %}
</div></section>
