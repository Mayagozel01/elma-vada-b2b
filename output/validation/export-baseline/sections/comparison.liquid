<section class="section">
  <div class="container">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <h2 class="section-title">Why local production matters</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); border-radius: 8px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.05); max-width: 900px; margin: 0 auto 3rem;">
      <!-- Left: Elma Vada (Navy) -->
      <div style="background: var(--color-navy); color: #fff; padding: 3rem 2rem;">
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 2rem; color: var(--color-gold);">Local DFW Studio (Elma Vada)</h3>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 1rem; line-height: 2;">
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: var(--color-gold);">✔</span> Faster turnaround
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: var(--color-gold);">✔</span> Easy communication
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: var(--color-gold);">✔</span> Samples available
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: var(--color-gold);">✔</span> Real-time quality control
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: var(--color-gold);">✔</span> Ability to adjust quickly
          </li>
        </ul>
      </div>

      <!-- Right: Overseas (Light) -->
      <div style="background: #fff; padding: 3rem 2rem;">
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 2rem; color: var(--color-navy);">Overseas Suppliers</h3>
        <ul style="list-style: none; padding: 0; margin: 0; font-size: 1rem; line-height: 2; color: var(--color-text-secondary);">
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: #999;">✕</span> Longer lead times
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: #999;">✕</span> Communication delays
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: #999;">✕</span> Harder to get samples
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: #999;">✕</span> Less control over quality
          </li>
          <li style="display: flex; gap: 0.75rem; margin-bottom: 1rem;">
            <span style="color: #999;">✕</span> Higher risk on deadlines
          </li>
        </ul>
      </div>
    </div>

    <div style="text-align: center;">
      <p style="font-size: 1.1rem; color: var(--color-text-secondary); margin-bottom: 1.5rem;">Don't leave your corporate gifting to chance. Partner with a specialized local facility.</p>
      <a href="/pages/request-a-quote" class="btn btn--primary">Request a Quote</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "presets": [{"name": "Comparison Table"}]
}
{% endschema %}
