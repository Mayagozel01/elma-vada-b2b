  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (Navy)",
        "default": "#1E252B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Gold)",
        "default": "#C09858"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (Cream)",
        "default": "#F4F2ED"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_etsy",
        "label": "Etsy Shop URL"
      }
    ]
  },
  {
    "name": "Analytics & verification",
    "settings": [
      {
        "type": "text",
        "id": "google_search_console_verification",
        "label": "Google Search Console verification code",
        "info": "Paste only the verification code, not the full meta tag."
      },
      {
        "type": "text",
        "id": "ga4_measurement_id",
        "label": "Google Analytics 4 measurement ID",
        "placeholder": "G-XXXXXXXXXX"
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "placeholder": "123456789012345"
      }
    ]
  },
  {
    "name": "Business & contact",
    "settings": [
      {
        "type": "text",
        "id": "business_name",
        "label": "Business name",
        "default": "Elma Vada Studio"
      },
      {
        "type": "text",
        "id": "business_email",
        "label": "Public email",
        "default": "daria@elmavada.com"
      },
      {
        "type": "text",
        "id": "business_phone",
        "label": "Phone — leave empty until ready"
      },
      {
        "type": "text",
        "id": "business_street",
        "label": "Street and suite",
        "default": "18383 Preston Rd, #202"
      },
      {
        "type": "text",
        "id": "business_city",
        "label": "City",
        "default": "Dallas"
      },
      {
        "type": "text",
        "id": "business_region",
        "label": "State",
        "default": "TX"
      },
      {
        "type": "text",
        "id": "business_postcode",
        "label": "ZIP",
        "default": "75252"
      },
      {
        "type": "text",
        "id": "business_area",
        "label": "Service area",
        "default": "Dallas–Fort Worth"
      },
      {
        "type": "text",
        "id": "business_hours",
        "label": "Business hours — confirmed only"
      },
      {
        "type": "image_picker",
        "id": "business_image",
        "label": "Real studio / team photo"
      },
      {
        "type": "checkbox",
        "id": "sms_enabled",
        "label": "Show Text Us for this phone",
        "default": false
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "International digits only. Leave empty to hide."
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp opening message",
        "default": "Hello! I would like to discuss a personalized gift project."
      },
      {
        "type": "checkbox",
        "id": "show_contact_bar",
        "label": "Show compact contact links",
        "default": true
      },
      {
        "type": "url",
        "id": "consultation_calendar_url",
        "label": "Optional external booking calendar"
      },
      {
        "type": "checkbox",
        "id": "show_header_trust",
        "label": "Show compact trust strip",
        "default": true
      },
      {
        "type": "text",
        "id": "header_trust_text",
        "label": "Header trust text",
        "default": "5+ years of experience · 50,000+ happy customers"
      }
    ]
  },
  {
    "name": "SEO & social preview",
    "settings": [
      {
        "type": "text",
        "id": "home_seo_title",
        "label": "Home SEO title",
        "default": "Personalized Corporate Gifts in Dallas | Elma Vada"
      },
      {
        "type": "textarea",
        "id": "home_seo_description",
        "label": "Home meta description",
