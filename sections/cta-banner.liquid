<section class="section bg-navy" style="text-align: center; color: #fff;">
  <div class="container" style="max-width: 600px;">
    <h2 class="section-title" style="color: #fff; margin-bottom: 1rem;">Ready to start your project?</h2>
    <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); line-height: 1.6; margin-bottom: 2.5rem;">
      Tell us about your volume, materials, and deadline. We’ll reply with a clear quote and timeline.
    </p>
    
    <div style="display: flex; flex-direction: column; gap: 1rem; align-items: center; justify-content: center;">
      <a href="/pages/request-a-quote" class="btn btn--primary" style="width: 100%; max-width: 300px;">Request a Quote</a>
      <a href="/pages/production-capabilities" class="btn btn--outline" style="width: 100%; max-width: 300px; color: #fff; border-color: rgba(255,255,255,0.3);">View Production Capabilities</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "presets": [{"name": "Final CTA"}]
}
{% endschema %}
