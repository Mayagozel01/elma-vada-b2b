      <form action="{{ routes.cart_url }}" method="post" data-cart-form
        data-section-id="cart-gift-offers" data-cart-count="{{ cart.item_count }}" data-cart-fingerprint="{% render 'cart-fingerprint', cart: cart %}"
        data-cart-update-url="{{ routes.cart_update_url }}.js" data-cart-change-url="{{ routes.cart_change_url }}.js">
        <div class="commerce-message commerce-cart__error" data-cart-message role="alert" tabindex="-1" hidden>
          <p data-cart-error-text></p>
          <button type="button" class="btn btn--outline" data-cart-retry hidden>Refresh cart</button>
          <a href="{{ routes.cart_url }}">Reload cart</a>
        </div>
        <div class="commerce-cart__items" data-cart-items>
          {% if cart.item_count == 0 %}<div class="catalog__empty"><h2>Your cart is empty</h2><a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Browse products</a></div>{% endif %}
          {% for item in cart.items %}
            <article class="commerce-cart__item" data-cart-variant="{{ item.variant.id }}">
              <a href="{{ item.url }}">{% if item.image != blank %}<img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="{{ item.image.width }}" height="{{ item.image.height }}" loading="lazy">{% endif %}</a>
              <div>
                <h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                {% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
                {% for property in item.properties %}
                  {% assign first_character = property.first | slice: 0 %}
                  {% if property.last != blank and first_character != '_' %}
                    <p class="commerce-note commerce-cart__property">{{ property.first | escape }}: {{ property.last | escape }}</p>
                    {% if property.first == 'Engraving text' and item.quantity > 1 %}<p class="commerce-note">This engraving text applies to all {{ item.quantity }} units in this cart item.</p>{% endif %}
                  {% endif %}
                {% endfor %}
                {% if item.selling_plan_allocation != blank %}<p class="commerce-note">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                {% for discount in item.line_level_discount_allocations %}<p class="commerce-note">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
                <a class="commerce-cart__remove" href="{{ item.url_to_remove | escape }}" data-cart-remove data-line-key="{{ item.key | escape }}">Remove</a>
              </div>
              <div class="commerce-field"><label for="CartQuantity-{{ forloop.index }}">Quantity</label><input type="number" id="CartQuantity-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" min="0" step="1" required data-cart-quantity data-line-key="{{ item.key | escape }}" data-initial-quantity="{{ item.quantity }}"></div>
              <p class="commerce-cart__price">{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s> {% endif %}{{ item.final_line_price | money }}</p>
            </article>
          {% endfor %}
          {% if cart.item_count > 0 and settings.enable_cart_gift_offers %}<p class="commerce-note"><a class="gift-offers-checkout-link" href="#CartCheckout">View total &amp; checkout — {{ cart.total_price | money }}</a></p>{% endif %}
        </div>
        {% render 'cart-gift-offers', cart: cart, settings: settings, routes: routes %}
        <div class="commerce-cart__footer" id="CartCheckout" tabindex="-1" data-cart-footer {% if cart.item_count == 0 %}hidden{% endif %}>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Continue shopping</a>
          <div class="commerce-cart__total">
            {% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</p>{% endfor %}
            <h2>Total: {{ cart.total_price | money }}</h2><p class="commerce-note">Shipping and applicable taxes are calculated at checkout.</p>
            <div class="commerce-cart__buttons"><button type="submit" name="update" class="btn btn--outline">Update cart</button><button type="submit" name="checkout" class="btn btn--primary">Checkout</button></div>
          </div>
        </div>
      </form>

