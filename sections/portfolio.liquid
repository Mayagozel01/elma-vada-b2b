<section class="section bg-beige"><div class="container">
  <div style="text-align: center; margin-bottom: 3rem;"><h2 class="section-title">{{ section.settings.heading }}</h2><p class="section-subtitle" style="font-size: 1.125rem; color: var(--color-text-secondary);">{{ section.settings.subheading }}</p></div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 3rem;">
    {%- for block in section.blocks -%}<article {{ block.shopify_attributes }} style="{% if forloop.first %}grid-column: 1 / -1;{% endif %} background: #fff; border-radius: 4px; overflow: hidden; text-align: left; box-shadow: 0 4px 15px rgba(0,0,0,0.05); padding-bottom: 1rem;">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy" style="width: 100%; height: {% if forloop.first %}350px{% else %}220px{% endif %}; object-fit: cover; display: block;">{% else %}<div style="width: 100%; height: {% if forloop.first %}350px{% else %}220px{% endif %}; background: #ddd; display: flex; align-items: center; justify-content: center; color: #777;">Upload a project photo</div>{% endif %}<div style="padding: 1rem 1rem 0.5rem;"><p style="margin: 0; font-family: var(--font-heading); font-size: {% if forloop.first %}1.3rem{% else %}1.05rem{% endif %}; color: var(--color-navy);">{{ block.settings.title }}</p></div></article>{%- endfor -%}
  </div>
  {% if section.settings.button_label != blank %}<div style="text-align: center;"><a href="{{ section.settings.button_url }}" class="btn btn--outline" style="border-color: var(--color-navy); color: var(--color-navy);">{{ section.settings.button_label }}</a></div>{% endif %}
</div></section>
{% schema %}
{"name":"Portfolio","settings":[{"type":"text","id":"heading","label":"Heading","default":"Real Projects. Real Production."},{"type":"textarea","id":"subheading","label":"Subheading","default":"Selected corporate and bulk projects from our DFW studio."},{"type":"text","id":"button_label","label":"Button label","default":"View Full Portfolio"},{"type":"url","id":"button_url","label":"Button link"}],"blocks":[{"type":"project","name":"Project","settings":[{"type":"image_picker","id":"image","label":"Project photo"},{"type":"text","id":"title","label":"Project title","default":"Custom branded project"}]}],"max_blocks":12,"presets":[{"name":"Portfolio Grid","blocks":[{"type":"project","settings":{"title":"Bulk engraved drinkware for Texas inspection company — 850 units"}},{"type":"project","settings":{"title":"Custom material corporate project — 250 units"}},{"type":"project","settings":{"title":"Custom branded project"}},{"type":"project","settings":{"title":"Custom branded project"}},{"type":"project","settings":{"title":"Custom branded project"}},{"type":"project","settings":{"title":"Custom branded project"}}]}]}
{% endschema %}
