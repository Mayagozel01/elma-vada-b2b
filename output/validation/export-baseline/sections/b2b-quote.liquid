<section class="b2b-section ev-quote-section" id="ProjectForm">
  <div class="container b2b-split b2b-quote">
    <div class="ev-quote__main">
      {% if section.settings.consultation_mode and settings.consultation_calendar_url != blank %}
        <p><a class="btn btn--primary" href="{{ settings.consultation_calendar_url }}" target="_blank" rel="noopener">View available consultation times</a></p>
      {% endif %}
      {% for block in section.blocks %}{% render block %}{% endfor %}
      {% if request.design_mode and section.settings.show_native_form == false and section.blocks.size == 0 %}<p class="b2b-editor-note">Добавьте app block формы с загрузкой SVG. Пока он отсутствует, посетителям доступна резервная форма со ссылкой на файл.</p>{% endif %}
      {% if section.settings.show_native_form or section.blocks.size == 0 %}
        {% assign form_id = 'B2BQuote-' | append: section.id %}
        {% form 'contact', id: form_id, class: 'b2b-form' %}
          <h2>{{ section.settings.form_heading | escape }}</h2>
          {% if form.posted_successfully? %}<p class="b2b-form__message" role="status" tabindex="-1">{{ section.settings.success_message | escape }}</p>{% endif %}
          {% if form.errors %}<div class="b2b-form__message" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
          <div class="b2b-form__fields">
            <div class="b2b-field--full"><label for="{{ form_id }}-request">How can we help?</label><select id="{{ form_id }}-request" name="contact[request_type]" data-request-type>
              {% assign request_types = 'Quote|Free mockup|Physical sample|Consultation|In-person consultation|Gifting calendar audit' | split: '|' %}
              {% assign selected_request = form.request_type | default: section.settings.default_request %}
              {% for request_type in request_types %}<option value="{{ request_type | escape }}" {% if selected_request == request_type %}selected{% endif %}>{{ request_type | escape }}</option>{% endfor %}
            </select></div>
            <div><label for="{{ form_id }}-name">{{ section.settings.name_label | escape }} *</label><input id="{{ form_id }}-name" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}" required></div>
            <div><label for="{{ form_id }}-company">{{ section.settings.company_label | escape }}{% if section.settings.company_required %} *{% endif %}</label><input id="{{ form_id }}-company" name="contact[company]" autocomplete="organization" value="{{ form.company | escape }}" {% if section.settings.company_required %}required{% endif %}></div>
            <div><label for="{{ form_id }}-email">{{ section.settings.email_label | escape }} *</label><input type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" value="{{ form.email | default: customer.email | escape }}" required {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}></div>
            <div><label for="{{ form_id }}-phone">{{ section.settings.phone_label | escape }}</label><input type="tel" id="{{ form_id }}-phone" name="contact[phone]" autocomplete="tel" value="{{ form.phone | default: customer.phone | escape }}"></div>
            <div><label for="{{ form_id }}-project">{{ section.settings.project_label | escape }}</label><select id="{{ form_id }}-project" name="contact[project_type]">{% assign options = section.settings.project_options | newline_to_br | split: '<br />' %}{% for option in options %}{% assign option_value = option | strip %}{% if option_value != blank %}<option value="{{ option_value | escape }}" {% if form.project_type == option_value %}selected{% endif %}>{{ option_value | escape }}</option>{% endif %}{% endfor %}</select></div>
            <div><label for="{{ form_id }}-quantity">{{ section.settings.quantity_label | escape }}</label><input type="number" min="1" step="1" id="{{ form_id }}-quantity" name="contact[quantity]" value="{{ form.quantity | escape }}" placeholder="From 1; leave blank if unsure"></div>
            <div><label for="{{ form_id }}-date">{{ section.settings.deadline_label | escape }}</label><input type="date" id="{{ form_id }}-date" name="contact[deadline]" value="{{ form.deadline | escape }}"></div>
            <div><label for="{{ form_id }}-budget">{{ section.settings.budget_label | escape }}</label><input id="{{ form_id }}-budget" name="contact[budget_range]" value="{{ form.budget_range | escape }}"></div>
            <div><label for="{{ form_id }}-delivery">{{ section.settings.delivery_label | escape }}</label><select id="{{ form_id }}-delivery" name="contact[delivery]">{% assign options = section.settings.delivery_options | newline_to_br | split: '<br />' %}{% for option in options %}{% assign option_value = option | strip %}{% if option_value != blank %}<option value="{{ option_value | escape }}" {% if form.delivery == option_value %}selected{% endif %}>{{ option_value | escape }}</option>{% endif %}{% endfor %}</select></div>
            <div><label for="{{ form_id }}-city">{{ section.settings.city_label | escape }}</label><input id="{{ form_id }}-city" name="contact[delivery_city_zip]" value="{{ form.delivery_city_zip | escape }}"></div>
            <div class="b2b-field--full"><label for="{{ form_id }}-artwork">{{ section.settings.artwork_label | escape }}</label><input type="url" id="{{ form_id }}-artwork" name="contact[artwork_link]" placeholder="https://" value="{{ form.artwork_link | escape }}" aria-describedby="{{ form_id }}-artwork-help"><div id="{{ form_id }}-artwork-help" class="b2b-rte">{{ section.settings.artwork_help }}</div></div>
            {% if section.settings.consultation_mode %}<div class="b2b-field--full"><label for="{{ form_id }}-meeting">Preferred meeting date / time (Dallas time)</label><input id="{{ form_id }}-meeting" name="contact[preferred_meeting]" value="{{ form.preferred_meeting | escape }}"><p class="ev-fine-print">We will confirm availability with you. Submitting this request does not book an appointment.</p></div>{% endif %}
            <div class="b2b-field--full"><label for="{{ form_id }}-body">{{ section.settings.notes_label | escape }}</label><textarea id="{{ form_id }}-body" name="contact[body]" rows="6">{{ form.body | escape }}</textarea></div>
          </div>
          <div class="b2b-rte">{{ section.settings.privacy_text }}</div>
          {% if shop.privacy_policy != blank %}<p><a class="b2b-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></p>{% endif %}
          <button class="btn btn--primary" type="submit" style="width:100%;margin-top:1rem">{{ section.settings.submit_label | escape }}</button>
        {% endform %}

      {% endif %}
    </div>
    <aside class="ev-quote__aside">
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="b2b-rte">{{ section.settings.text }}</div>
      {% if section.settings.image != blank or request.design_mode %}
        <div style="margin-top:2rem">{% render 'b2b-image', photo: section.settings.image, alt: section.settings.image_alt, title: section.settings.heading, note: section.settings.photo_note %}</div>
      {% endif %}
      <div class="b2b-rte" style="margin-top:2rem">{{ section.settings.after_text }}</div>
    </aside>
  </div>
</section>
{% schema %}
{
  "name": "B2B quote form",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "default_request",
      "label": "Default request type",
      "options": [
        {
          "value": "Quote",
          "label": "Quote"
        },
        {
          "value": "Free mockup",
          "label": "Free mockup"
        },
        {
          "value": "Physical sample",
          "label": "Physical sample"
        },
        {
          "value": "Consultation",
          "label": "Consultation"
        },
        {
          "value": "In-person consultation",
          "label": "In-person consultation"
        },
        {
          "value": "Gifting calendar audit",
          "label": "Gifting calendar audit"
        }
      ],
      "default": "Quote"
    },
    {
      "type": "checkbox",
      "id": "company_required",
      "label": "Company is required",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "consultation_mode",
      "label": "Show consultation time request",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Side heading",
      "default": "You can reduce the risk before committing."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Side text",
      "default": "<p>Free mockup • 15-minute project call • physical sample where qualifying • in-person sample review for qualifying bulk projects.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional sample photo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description (alt)"
    },
    {
      "type": "textarea",
      "id": "photo_note",
      "label": "Photo brief (editor only)",
      "default": "Один реальный готовый подарок рядом с согласованным эскизом. Не обязательно."
    },
    {
      "type": "richtext",
      "id": "after_text",
      "label": "Additional information",
      "default": "<p>One human contact from quote to delivery. Free digital proof before production. PO-friendly ordering for approved accounts. Approved artwork retained for easy reorders.</p><p><a href=\"/pages/free-mockup\">Request a free mockup</a> or <a href=\"/pages/book-a-call?request=in-person\">request an in-person consultation</a>.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_native_form",
      "label": "Show built-in contact form",
      "default": true,
      "info": "For actual file uploads, add a form app block and disable this form after testing the app."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Tell us about your project"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Full name"
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company label",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Work email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone (optional)"
    },
    {
      "type": "text",
      "id": "project_label",
      "label": "Project label",
      "default": "Project type"
    },
    {
      "type": "textarea",
      "id": "project_options",
      "label": "Project options (one per line)",
      "default": "Not sure yet\nDigital mockup request\nPhysical sample request\nCorporate gifts\nEmployee recognition\nClient gifts\nEvents and awards\nOnboarding kits\nMilestone program\nBulk engraving\nPromotional products"
    },
    {
      "type": "text",
      "id": "quantity_label",
      "label": "Quantity label",
      "default": "Estimated quantity"
    },
    {
      "type": "text",
      "id": "deadline_label",
      "label": "Deadline label",
      "default": "Needed by"
    },
    {
      "type": "text",
      "id": "budget_label",
      "label": "Budget label",
      "default": "Budget range (optional)"
    },
    {
      "type": "text",
      "id": "delivery_label",
      "label": "Delivery label",
      "default": "Preferred fulfillment"
    },
    {
      "type": "textarea",
      "id": "delivery_options",
      "label": "Delivery options (one per line)",
      "default": "Please advise\nPickup inquiry\nLocal delivery inquiry\nShipping inquiry\nMultiple recipient addresses"
    },
    {
      "type": "text",
      "id": "city_label",
      "label": "City label",
      "default": "Delivery city / ZIP"
    },
    {
      "type": "text",
      "id": "artwork_label",
      "label": "Artwork label",
      "default": "Logo / artwork link (optional)"
    },
    {
      "type": "richtext",
      "id": "artwork_help",
      "label": "Artwork instructions",
      "default": "<p>Share a viewable artwork link, or email your SVG/PDF logo to <a href=\"mailto:daria@elmavada.com\">daria@elmavada.com</a>. You can send your request now and provide artwork later. Do not share private recipient lists in a public link.</p>"
    },
    {
      "type": "text",
      "id": "notes_label",
      "label": "Notes label",
      "default": "Occasion, materials, names and project details"
    },
    {
      "type": "richtext",
      "id": "privacy_text",
      "label": "Privacy note",
      "default": "<p>We use the details you share to respond to your project inquiry.</p>"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Send My Request"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Your request has been sent. We will contact you to discuss the next step."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "B2B quote form"
    }
  ]
}
{% endschema %}
