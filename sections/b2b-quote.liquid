{% liquid
  assign has_video = false
  if section.settings.media_type == 'video' and section.settings.video != blank
    assign has_video = true
  endif
%}
<section class="b2b-section ev-quote-section" id="ProjectForm"{% if template.suffix == 'book-a-call' %} data-consultation-call{% endif %}>
  <div class="container b2b-split b2b-quote">
    <aside class="ev-quote__aside">
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="b2b-rte">{{ section.settings.text }}</div>
      {% if section.settings.image != blank or has_video or request.design_mode %}
        <div style="margin-top:2rem">{% render 'b2b-image', media_type: section.settings.media_type, video: section.settings.video, poster: section.settings.poster, photo: section.settings.image, alt: section.settings.image_alt, title: section.settings.heading, note: section.settings.photo_note %}</div>
      {% endif %}
      <div class="b2b-rte" style="margin-top:2rem">{{ section.settings.after_text }}</div>
    </aside>
    <div class="ev-quote__main">
      {% if section.settings.consultation_mode and settings.consultation_calendar_url != blank %}
        <p><a class="btn btn--primary" href="{{ settings.consultation_calendar_url }}" target="_blank" rel="noopener">View available consultation times</a></p>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <div class="ev-shopify-form" data-shopify-quote-form>
          {% for block in section.blocks %}{% render block %}{% endfor %}
        </div>
      {% endif %}
      {% if request.design_mode and section.blocks.size == 0 %}<p class="b2b-editor-note">Add the Shopify Forms inline block and use Form ID 1155185.</p>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "B2B quote form",
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "consultation_mode",
      "label": "Show consultation time request",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Side heading",
      "default": "You can reduce the risk before committing."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Side text",
      "default": "<p>Free mockup • 15-minute project call • physical sample where qualifying • office visits in Dallas–Fort Worth by appointment.</p>"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video — play on click, muted"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Optional sample photo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video — no autoplay or sound"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Video cover (optional)",
      "info": "Uses the video's preview image if empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Photo description (alt)"
    },
    {
      "type": "textarea",
      "id": "photo_note",
      "label": "Photo brief (editor only)",
      "default": "Один реальный готовый подарок рядом с согласованным эскизом. Не обязательно."
    },
    {
      "type": "richtext",
      "id": "after_text",
      "label": "Additional information",
      "default": "<p>One human contact from quote to delivery. Free digital proof before production. PO-friendly ordering for approved accounts. Approved artwork retained for easy reorders.</p><p><a href=\"/pages/free-mockup\">Request a free mockup</a> or <a href=\"/pages/book-a-call?request=in-person\">request an office visit</a>.</p>"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "B2B quote form"
    }
  ]
}
{% endschema %}
