<section class="stats-bar" aria-label="Our experience">
  <div class="container ev-stats">
    <div><strong>{{ section.settings.value_1 | escape }}</strong><span>{{ section.settings.label_1 | escape }}</span></div>
    <div><strong>{{ section.settings.value_2 | escape }}</strong><span>{{ section.settings.label_2 | escape }}</span></div>
    <div><strong>{{ section.settings.value_3 | escape }}</strong><span>{{ section.settings.label_3 | escape }}</span></div>
    <div><strong>{{ section.settings.value_4 | escape }}</strong><span>{{ section.settings.label_4 | escape }}</span></div>
  </div>
</section>
{% schema %}
{
  "name": "Stats Bar",
  "settings": [
    {
      "type": "text",
      "id": "value_1",
      "label": "Value 1",
      "default": "5+"
    },
    {
      "type": "text",
      "id": "label_1",
      "label": "Label 1",
      "default": "Years of Experience"
    },
    {
      "type": "text",
      "id": "value_2",
      "label": "Value 2",
      "default": "10+"
    },
    {
      "type": "text",
      "id": "label_2",
      "label": "Label 2",
      "default": "Team Members"
    },
    {
      "type": "text",
      "id": "value_3",
      "label": "Value 3",
      "default": "50,000+"
    },
    {
      "type": "text",
      "id": "label_3",
      "label": "Label 3",
      "default": "Happy Customers"
    },
    {
      "type": "text",
      "id": "value_4",
      "label": "Value 4",
      "default": "100,000+"
    },
    {
      "type": "text",
      "id": "label_4",
      "label": "Label 4",
      "default": "Engraved Gifts"
    }
  ],
  "presets": [
    {
      "name": "Stats Bar"
    }
  ]
}
{% endschema %}
