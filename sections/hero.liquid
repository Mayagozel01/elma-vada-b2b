<section class="hero hero-carousel" id="Hero" data-hero-carousel data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_speed | times: 1000 }}" aria-roledescription="carousel" aria-label="{{ section.settings.carousel_label }}">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <article class="hero-carousel__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}" {{ block.shopify_attributes }}>
        <div class="hero__content">
          {%- if block.settings.eyebrow != blank -%}<span class="hero__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
          <h1 class="hero__title">{{ block.settings.heading }}</h1>
          <div class="hero__divider" aria-hidden="true"></div>
          {%- if block.settings.subheading != blank -%}<p class="hero__subheading">{{ block.settings.subheading }}</p>{%- endif -%}
          {%- if block.settings.body_text != blank -%}<p class="hero__body">{{ block.settings.body_text }}</p>{%- endif -%}
          {%- if block.settings.primary_cta_text != blank or block.settings.secondary_cta_text != blank -%}
            <div class="hero__actions">
              {%- if block.settings.primary_cta_text != blank -%}<a href="{{ block.settings.primary_cta_url | default: '/pages/request-a-quote' }}" class="btn btn--primary">{{ block.settings.primary_cta_text }}</a>{%- endif -%}
              {%- if block.settings.secondary_cta_text != blank -%}<a href="{{ block.settings.secondary_cta_url | default: '/pages/our-work' }}" class="btn btn--outline">{{ block.settings.secondary_cta_text }}</a>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
        <div class="hero__image-wrapper">
          {%- if block.settings.image != blank -%}
            <img class="hero__image" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" {% if forloop.first %}fetchpriority="high"{% endif %}>
          {%- elsif forloop.index == 1 -%}
            <img class="hero__image" src="{{ 'hero-production-studio.png' | asset_url }}" alt="Illustrative concept of an engraving studio, not a photograph of our facility" width="1672" height="941" loading="eager" fetchpriority="high">
          {%- elsif forloop.index == 2 -%}
            <img class="hero__image" src="{{ 'hero-corporate-gifts.png' | asset_url }}" alt="Illustrative corporate gift concept" width="1672" height="941" loading="lazy">
          {%- elsif forloop.index == 3 -%}
            <img class="hero__image" src="{{ 'hero-bulk-orders.png' | asset_url }}" alt="Illustrative concept of order packing, not a photograph of our facility" width="1672" height="941" loading="lazy">
          {%- else -%}
            <div class="hero__image hero__image--placeholder">Upload a slide image in Theme editor</div>
          {%- endif -%}
          {%- if block.settings.badge_title != blank or block.settings.badge_text != blank -%}<div class="hero__badge"><div class="hero__badge-eyebrow">{{ block.settings.badge_title }}</div><div class="hero__badge-text">{{ block.settings.badge_text }}</div></div>{%- endif -%}
          {% if block.settings.image == blank %}<p class="hero__concept-label">Illustrative concept · AI-generated</p>{% endif %}
        </div>
      </article>
    {%- endfor -%}
    {%- if section.blocks.size > 1 -%}
      <div class="hero-carousel__controls">
        <button type="button" class="hero-carousel__arrow" data-hero-prev aria-label="Previous slide">←</button>
        <div class="hero-carousel__dots" role="tablist" aria-label="Choose slide">
          {%- for block in section.blocks -%}<button type="button" class="hero-carousel__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot data-slide-index="{{ forloop.index0 }}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Slide {{ forloop.index }}"></button>{%- endfor -%}
        </div>
        <button type="button" class="hero-carousel__arrow" data-hero-next aria-label="Next slide">→</button>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="hero__content"><span class="hero__eyebrow">Add slides in Theme editor</span><h1 class="hero__title">Your hero carousel</h1><div class="hero__divider"></div><p class="hero__body">Add up to three slides, each with its own photo, text, and buttons.</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero carousel",
  "settings": [
    {"type":"text","id":"carousel_label","label":"Carousel label","default":"Featured services"},
    {"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},
    {"type":"range","id":"autoplay_speed","label":"Seconds between slides","min":3,"max":10,"step":1,"default":6}
  ],
  "blocks": [
    {"type":"slide","name":"Slide","limit":3,"settings":[
      {"type":"image_picker","id":"image","label":"Slide image"},
      {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Corporate Gifts · In-House Engraving · Plano, Texas"},
      {"type":"text","id":"heading","label":"Heading","default":"Local DFW Production & Branding Studio"},
      {"type":"textarea","id":"subheading","label":"Subheading","default":"Custom branded products, gifts, and merchandise for businesses — from 10 to 5,000+ units."},
      {"type":"textarea","id":"body_text","label":"Body text","default":"Local production, precise branding, and reliable support from proof to delivery."},
      {"type":"text","id":"primary_cta_text","label":"Primary button text","default":"Request a Quote"},
      {"type":"url","id":"primary_cta_url","label":"Primary button link"},
      {"type":"text","id":"secondary_cta_text","label":"Secondary button text","default":"View Our Work"},
      {"type":"url","id":"secondary_cta_url","label":"Secondary button link"},
      {"type":"text","id":"badge_title","label":"Image badge title","default":"Produced In-House"},
      {"type":"textarea","id":"badge_text","label":"Image badge text","default":"Plano, Texas · CO₂ & Fiber Laser\nUV Print · Precision Engraving"}
    ]}
  ],
  "presets": [{"name":"Hero carousel","blocks":[
    {"type":"slide","settings":{"heading":"Local DFW Production & Branding Studio","subheading":"Custom branded products, gifts, and merchandise for businesses — from 10 to 5,000+ units."}},
    {"type":"slide","settings":{"eyebrow":"Corporate Gifts · Employee Recognition","heading":"Gifts Your Team and Clients Keep","subheading":"Premium branded gifts made locally with precision engraving and thoughtful presentation."}},
    {"type":"slide","settings":{"eyebrow":"Bulk Orders · Fast Local Production","heading":"Built for Business-Scale Orders","subheading":"From 10 to 5,000+ units, we manage proofs, production, quality control, and delivery."}}
  ]}]
}
{% endschema %}
