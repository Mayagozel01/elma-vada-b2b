<div style="background-color: var(--color-cream); min-height: 60vh; display: flex; align-items: center; padding: var(--space-24) 0;">
  <div class="container" style="text-align: center; max-width: 520px; margin: 0 auto;">
    <span class="eyebrow">Elma Vada Studio</span>
    <h1 style="font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 4rem); color: var(--color-navy); margin-bottom: var(--space-6);">
      Opening Soon
    </h1>
    <p style="font-size: var(--fs-lg); color: var(--color-text-secondary); max-width: 44ch; margin: 0 auto var(--space-10);">
      This store is password protected. Enter the password to preview the studio site.
    </p>
    {% form 'storefront_password' %}
      {% if form.errors %}
        <p style="color: #721C24; margin-bottom: var(--space-4);">{{ form.errors | default_errors }}</p>
      {% endif %}
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <input
          type="password"
          name="password"
          class="form__input"
          placeholder="Password"
          aria-label="Password"
          style="max-width: 240px;"
        >
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {% endform %}
  </div>
</div>
