{% liquid
  assign visible_count = 0
  for block in section.blocks
    assign has_video = false
    if block.settings.media_type == 'video' and block.settings.video != blank
      assign has_video = true
    endif
    assign show_card = true
    if block.settings.requires_approval and block.settings.approved == false
      assign show_card = false
    endif
    if section.settings.require_photo and block.settings.image == blank and has_video == false
      assign show_card = false
    endif
    if show_card
      assign visible_count = visible_count | plus: 1
    endif
  endfor
%}
{% if visible_count > 0 or section.blocks.size == 0 or request.design_mode %}
<section class="b2b-section b2b-section--{{ section.settings.color_scheme }}">
  <div class="container">
    {% if section.settings.heading != blank or section.settings.text != blank %}
      <div class="b2b-header">
        {% if section.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
        <div class="b2b-rte">{{ section.settings.text }}</div>
      </div>
    {% endif %}
    <div class="{% if section.settings.layout == 'stories' %}b2b-stories{% else %}b2b-grid{% endif %}" style="--b2b-columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        {% liquid
          assign has_video = false
          if block.settings.media_type == 'video' and block.settings.video != blank
            assign has_video = true
          endif
          assign show_card = true
          if block.settings.requires_approval and block.settings.approved == false
            assign show_card = false
          endif
          if section.settings.require_photo and block.settings.image == blank and has_video == false
            assign show_card = false
          endif
        %}
        {% if show_card or request.design_mode %}
          <article class="b2b-card{% if block.settings.show_image == false %} b2b-card--text-only{% elsif block.settings.image == blank and has_video == false and request.design_mode == false %} b2b-card--text-only{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.show_image %}{% render 'b2b-image', media_type: block.settings.media_type, video: block.settings.video, poster: block.settings.poster, photo: block.settings.image, alt: block.settings.image_alt, title: block.settings.title, note: block.settings.photo_note, fit: section.settings.image_fit, sizes: '(min-width: 990px) 30vw, (min-width: 641px) 50vw, 100vw' %}{% endif %}
            <div class="b2b-card__body">
              {% if request.design_mode and show_card == false %}<p class="b2b-editor-note">Не видно посетителям: добавьте фото и/или подтвердите разрешение на публикацию в настройках блока.</p>{% endif %}
              {% if block.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
              {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
              <div class="b2b-rte">{{ block.settings.text }}</div>
              {% if block.settings.link != blank and block.settings.link_label != blank %}<a class="b2b-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.settings.button_link != blank and section.settings.button_label != blank %}<div class="b2b-actions" style="justify-content:center"><a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a></div>{% endif %}
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "B2B content & photos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What can we create for your team?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Card grid"
        },
        {
          "value": "stories",
          "label": "Photo beside text"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo crop",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame"
        },
        {
          "value": "contain",
          "label": "Show whole product"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "navy",
          "label": "Dark"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "require_photo",
      "label": "Hide cards without photos on storefront",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Photo / content card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personalized gift"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A thoughtful starting point, personalized for your occasion.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_image",
          "label": "Include image or video",
          "default": true
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video — play on click, muted"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video — no autoplay or sound"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video cover (optional)",
          "info": "Uses the video's preview image if empty."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo description (alt)"
        },
        {
          "type": "textarea",
          "id": "photo_note",
          "label": "Photo brief (editor only)",
          "default": "Фото реального изделия, 1200 × 900 px. Не размещайте неподтверждённые логотипы клиентов."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link text",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "requires_approval",
          "label": "Require approval before publishing (case studies)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "approved",
          "label": "Facts and publication permission confirmed",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "B2B content & photos",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
