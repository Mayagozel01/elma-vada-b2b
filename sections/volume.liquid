<section class="section bg-beige">
  <div class="container">
    <div style="max-width: 700px; margin: 0 auto 3.5rem; text-align: center;">
      <h2 class="section-title">From 10 to 5000+ Units</h2>
      <p style="color: var(--color-text-secondary); font-size: 1.125rem; line-height: 1.6;">
        We handle small batches, bulk orders, event runs, and full corporate projects with the same level of precision and care.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
      <div style="background: #fff; border-top: 4px solid var(--color-navy); padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-navy); margin-bottom: 0.5rem;">Small Batches</h3>
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-gold); margin-bottom: 1rem;">10 – 100 Units</div>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.5;">Ideal for tight teams, executive gifts, or testing pilot merchandise before a big launch.</p>
      </div>
      
      <div style="background: #fff; border-top: 4px solid var(--color-navy); padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-navy); margin-bottom: 0.5rem;">Mid-Volume</h3>
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-gold); margin-bottom: 1rem;">100 – 1000 Units</div>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.5;">Perfect for mid-sized company events, client mailers, and holiday appreciation gifts.</p>
      </div>
      
      <div style="background: #fff; border-top: 4px solid var(--color-navy); padding: 2.5rem 1.5rem; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.03);">
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; color: var(--color-navy); margin-bottom: 0.5rem;">Large Bulk & Corporate</h3>
        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-gold); margin-bottom: 1rem;">1000 – 5000+ Units</div>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); line-height: 1.5;">Enterprise scale. Produced with multi-machine parallel efficiency without losing detail.</p>
      </div>
    </div>

    <div style="text-align: center;">
      <a href="/pages/request-a-quote" class="btn btn--primary">Start Your Project</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Volume",
  "presets": [{"name": "Volume Section"}]
}
{% endschema %}
