{% comment %}Editor-only shot guidance; no fake photos or empty frames on the storefront.{% endcomment %}
{% if media_type == 'video' and video != blank %}
  {% liquid
    assign cover = poster | default: video.preview_image
    assign cover_url = ''
    if cover != blank
      assign cover_url = cover | image_url: width: 1800
    endif
    assign video_label = alt | default: title | default: 'Engraving video'
  %}
  <figure class="b2b-media ev-page-video{% if fit == 'contain' %} b2b-media--contain{% endif %}" data-ev-hero data-autoplay="false" aria-label="{{ video_label | escape }}">
    <div data-ev-slide>
      {{ video | video_tag: image_size: '1800x', poster: cover_url, controls: true, autoplay: false, muted: true, loop: false, playsinline: true, preload: 'none' }}
      <button type="button" class="ev-video-toggle" data-ev-video-toggle aria-label="Play video without sound" aria-pressed="false" hidden>
        <svg class="ev-video-toggle__play" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M12 7 26 16 12 25Z" fill="currentColor"/></svg>
        <svg class="ev-video-toggle__pause" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M10 8h4v16h-4zM19 8h4v16h-4z" fill="currentColor"/></svg>
      </button>
      <p class="ev-page-video__message" data-ev-video-message role="status" hidden></p>
    </div>
  </figure>
{% elsif photo != blank %}
  {% assign photo_alt = alt | default: photo.alt | default: title %}
  <figure class="b2b-media{% if fit == 'contain' %} b2b-media--contain{% endif %}">
    <img src="{{ photo | image_url: width: 1800 }}"
      srcset="{{ photo | image_url: width: 400 }} 400w, {{ photo | image_url: width: 750 }} 750w, {{ photo | image_url: width: 1100 }} 1100w, {{ photo | image_url: width: 1800 }} 1800w"
      sizes="{{ sizes | default: '(min-width: 990px) 40vw, 100vw' }}"
      alt="{{ photo_alt | escape }}" width="{{ photo.width }}" height="{{ photo.height }}"
      loading="{% if eager %}eager{% else %}lazy{% endif %}" {% if eager %}fetchpriority="high"{% endif %}
      style="object-position: {{ photo.presentation.focal_point | default: '50% 50%' }};">
  </figure>
{% elsif request.design_mode %}
  <div class="b2b-placeholder">
    {{ 'image' | placeholder_svg_tag }}
    <p><strong>{{ title | escape }}</strong><br>{{ note | default: 'Загрузите реальное фото в настройках этого блока.' | escape }}</p>
    <small>Подсказка видна только в редакторе темы.</small>
  </div>
{% endif %}
