{% liquid
  assign related_collection = product.metafields.custom.related_collection.value | default: section.settings.collection
  if related_collection == blank
    assign related_collection = product.collections.first
  endif
  assign related_count = 0
  for item in related_collection.products
    if item.id != product.id
      assign related_count = related_count | plus: 1
    endif
  endfor
%}
{% if related_count > 0 %}
  <section class="b2b-section b2b-section--cream product-related">
    <div class="container">
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="catalog__grid" role="list">
        {% assign shown = 0 %}
        {% for item in related_collection.products %}
          {% if item.id != product.id %}
            {% render 'catalog-product-card', card_product: item, card_index: 5, card_label: 'View product', show_price: settings.show_catalog_prices, show_inventory_quantity: settings.show_inventory_quantity, low_stock_threshold: settings.low_stock_threshold %}
            {% assign shown = shown | plus: 1 %}
            {% if shown >= section.settings.products_to_show %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name":"Related products",
  "settings":[
    {"type":"text","id":"heading","label":"Heading","default":"You may also like"},
    {"type":"collection","id":"collection","label":"Fallback related collection","info":"Uses the product's custom.related_collection first, then this selection, then its first collection."},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":4,"step":1,"default":4}
  ],
  "presets":[{"name":"Related products"}],
  "enabled_on":{"templates":["product"]}
}
{% endschema %}
