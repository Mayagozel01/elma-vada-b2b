<section class="section" style="padding: 4rem 1rem;"><div class="container" style="max-width: 1120px;"><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:3rem;align-items:start;">
  <div>{% if product.featured_image != blank %}<img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" style="width:100%;height:auto;display:block;border-radius:4px;">{% else %}<div style="aspect-ratio:1;background:#eaeaea;display:grid;place-items:center;color:#777;">Product photo</div>{% endif %}</div>
  <div><p style="font-size:.85rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--color-gold);margin:0 0 .75rem;">{{ product.vendor }}</p><h1 style="font-family:var(--font-heading);font-size:clamp(2.5rem,5vw,3.5rem);color:var(--color-navy);margin:0 0 1rem;">{{ product.title }}</h1><p style="font-size:1.3rem;color:var(--color-navy);font-weight:600;margin:0 0 1.5rem;">{{ product.selected_or_first_available_variant.price | money }}</p><div style="color:var(--color-text-secondary);line-height:1.6;margin-bottom:2rem;">{{ product.description }}</div>
    {% form 'product', product %}<label for="VariantSelect" style="display:block;font-weight:600;color:var(--color-navy);margin-bottom:.5rem;">Options</label><select id="VariantSelect" name="id" style="width:100%;padding:.85rem;border:1px solid #ccc;border-radius:4px;margin-bottom:1rem;">{% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}</option>{% endfor %}</select><label for="Quantity" style="display:block;font-weight:600;color:var(--color-navy);margin-bottom:.5rem;">Quantity</label><input id="Quantity" type="number" name="quantity" value="1" min="1" style="width:100%;padding:.85rem;border:1px solid #ccc;border-radius:4px;margin-bottom:1rem;"><button type="submit" class="btn btn--primary" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>{% endform %}
  </div>
</div></div></section>
