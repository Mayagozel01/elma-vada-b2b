{% liquid
  assign lead = section.blocks.first
  assign media_count = 0
  for block in section.blocks
    if block.settings.media_type == 'video' and block.settings.video != blank
      assign media_count = media_count | plus: 1
    elsif block.settings.image != blank or request.design_mode
      assign media_count = media_count | plus: 1
    endif
  endfor
%}
<section class="ev-hero{% if media_count == 0 %} ev-hero--text-only{% endif %}" data-ev-hero data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.autoplay_speed | times: 1000 }}" aria-label="{{ section.settings.carousel_label | escape }}">
  <div class="container ev-hero__grid">
    <div class="ev-hero__copy">
      <p class="b2b-eyebrow">{{ lead.settings.eyebrow | default: 'LASER ENGRAVING STUDIO · SERVING DALLAS–FORT WORTH, TEXAS' | escape }}</p>
      <h1>{{ lead.settings.heading | default: 'Engraved Corporate Gifts, Personalized for Every Recipient' | escape }}</h1>
      {% if lead.settings.subheading != blank %}<p class="ev-hero__intro">{{ lead.settings.subheading | escape }}</p>{% endif %}
      {% if lead.settings.body_text != blank %}<p>{{ lead.settings.body_text | escape }}</p>{% endif %}
      {% if lead.settings.bulk_quote %}{% render 'bulk-order-note' %}{% endif %}
      {% if section.settings.benefit_1 != blank or section.settings.benefit_2 != blank %}
        <ul class="ev-hero__benefits">
          {% if section.settings.benefit_1 != blank %}<li>{{ section.settings.benefit_1 | escape }}</li>{% endif %}
          {% if section.settings.benefit_2 != blank %}<li>{{ section.settings.benefit_2 | escape }}</li>{% endif %}
        </ul>
      {% endif %}
      <div class="b2b-actions">
        <a class="btn btn--primary" {% if lead.settings.bulk_quote %}data-ev-bulk-cta="{{ section.id }}:primary"{% if request.page_type == 'index' %} data-ev-bulk-pulse{% endif %}{% endif %} href="{{ lead.settings.primary_cta_url | default: '/pages/request-a-quote#ProjectForm' }}">{{ lead.settings.primary_cta_text | default: 'Get a Free Mockup' | escape }}</a>
        <a class="btn btn--outline" href="{{ lead.settings.secondary_cta_url | default: '/collections/all' }}">{{ lead.settings.secondary_cta_text | default: 'See Pricing' | escape }}</a>
      </div>
      {% if section.settings.trust_line != blank %}<p class="ev-hero__trust">{{ section.settings.trust_line | escape }}</p>{% endif %}
      {% if section.settings.footnote != blank %}<p class="ev-hero__footnote">{{ section.settings.footnote | escape }}</p>{% endif %}
    </div>
    {% if media_count > 0 %}
      <div class="ev-hero__media" role="group" aria-roledescription="carousel" aria-label="Gift and engraving media">
        {% assign media_index = 0 %}
        {% for block in section.blocks %}
          {% liquid
            assign show_media = false
            if block.settings.media_type == 'video' and block.settings.video != blank
              assign show_media = true
            elsif block.settings.image != blank or request.design_mode
              assign show_media = true
            endif
          %}
          {% if show_media %}
            {% liquid
              assign poster = block.settings.poster
              assign poster_url = ''
              if poster != blank
                assign poster_url = poster | image_url: width: 1600
              elsif block.settings.poster_style == 'metal' or block.settings.poster_style == 'ribbon' or block.settings.poster_style == 'layers'
                assign poster_asset = 'hero-video-cover-' | append: block.settings.poster_style | append: '.png'
                assign poster_url = poster_asset | asset_url
              elsif block.settings.video.preview_image != blank
                assign poster_url = block.settings.video.preview_image | image_url: width: 1600
              endif
              assign media_alt = block.settings.image_alt | default: block.settings.image.alt | default: block.settings.heading
              assign image_loading = 'lazy'
              assign image_priority = 'auto'
              if media_index == 0
                assign image_loading = 'eager'
                assign image_priority = 'high'
              endif
            %}
            {% if media_index == 0 and block.settings.media_type == 'video' and block.settings.video != blank and poster_url != blank %}
              <link rel="preload" as="image" href="{{ poster_url | escape }}" fetchpriority="high">
            {% endif %}
            <figure class="ev-hero__slide" data-ev-slide data-block-id="{{ block.id }}" {% unless media_index == 0 %}hidden inert{% endunless %} aria-label="{{ media_index | plus: 1 }} / {{ media_count }}" {{ block.shopify_attributes }}>
              {% if block.settings.media_type == 'video' and block.settings.video != blank %}
                {{ block.settings.video | video_tag: image_size: '1600x', poster: poster_url, controls: true, autoplay: false, muted: true, loop: true, playsinline: true, preload: 'none', class: 'ev-hero__visual' | replace: '<img ', '<img loading="lazy" fetchpriority="low" ' }}
                <button type="button" class="ev-video-toggle" data-ev-video-toggle aria-label="Play video without sound" aria-pressed="false" hidden>
                  <svg class="ev-video-toggle__play" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M12 7 26 16 12 25Z" fill="currentColor"/></svg>
                  <svg class="ev-video-toggle__pause" width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path d="M10 8h4v16h-4zM19 8h4v16h-4z" fill="currentColor"/></svg>
                </button>
                <p class="ev-video-message" data-ev-video-message role="status" hidden></p>
              {% elsif block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'ev-hero__visual', widths: '480, 750, 1100, 1600, 2000', sizes: '(min-width: 1025px) 50vw, 100vw', alt: media_alt, loading: image_loading, fetchpriority: image_priority }}
              {% elsif request.design_mode %}
                <div class="b2b-placeholder"><p>Загрузите реальное фото или выберите Video и загрузите ролик. Пустой слайд скрыт от посетителей.</p></div>
              {% endif %}
              {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
            </figure>
            {% assign media_index = media_index | plus: 1 %}
          {% endif %}
        {% endfor %}
        <div class="ev-hero__controls" data-ev-controls hidden>
          <button type="button" data-ev-prev aria-label="Previous media">←</button>
          <span data-ev-status aria-live="polite">1 / {{ media_count }}</span>
          <button type="button" data-ev-next aria-label="Next media">→</button>
          <button type="button" data-ev-pause aria-pressed="true">Play slideshow</button>
        </div>
      </div>
    {% endif %}
  </div>
</section>
{% stylesheet %}
  .ev-hero__benefits { display: grid; gap: .45rem; margin: 1.1rem 0 0; padding: 0; list-style: none; font-weight: 600; line-height: 1.45; }
  .ev-hero__benefits + .b2b-actions { margin-top: 1.4rem; }
  .ev-hero__trust { margin: 1.1rem 0 0; font-size: .9rem; font-weight: 600; }
  .ev-hero__footnote { margin: .6rem 0 0; font-size: .8rem; line-height: 1.5; opacity: .85; }
{% endstylesheet %}
{% schema %}
{
  "name": "Hero — photos & video",
  "settings": [
    {
      "type": "text",
      "id": "carousel_label",
      "label": "Carousel label",
      "default": "Featured services"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "✓ Approve your sample Monday — delivered to your office Wednesday, free*"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "✓ No MOQ · 1 to 5,000+ pieces · from $9.99 per gift"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "110,000+ orders shipped · 5+ years in business"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "* 1 business day production after proof approval, then next-business-day delivery to your office. Production time applies to orders of up to 1,000 pens, 600 chopsticks, 300 drinkware pieces, or 50 awards. Office delivery: Dallas–Fort Worth for orders of 100+ pieces; Houston, Austin and Oklahoma City for orders of 1,000+ pieces."
    },
    {
      "type": "paragraph",
      "content": "The first slide supplies the eyebrow, headline, description and buttons. All slides supply photos/videos. Empty media are hidden from customers."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Shopify video"
            }
          ],
          "default": "image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Shopify video"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Video poster",
          "info": "Your uploaded poster takes priority over the preset below."
        },
        {
          "type": "select",
          "id": "poster_style",
          "label": "Video cover preset",
          "default": "video",
          "options": [
            { "value": "video", "label": "Frame from video" },
            { "value": "metal", "label": "Gold engraved lines" },
            { "value": "ribbon", "label": "Gold gift ribbon" },
            { "value": "layers", "label": "Navy and gold layers" }
          ]
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photo description"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Media caption"
        },
        {
          "type": "paragraph",
          "content": "Videos always start on Play and stay muted. Choose a Video poster for the cover shown before playback."
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop video",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "LASER ENGRAVING STUDIO · SERVING DALLAS–FORT WORTH, TEXAS"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (H1)",
          "default": "Engraved Corporate Gifts, Personalized for Every Recipient"
        },
        {
          "type": "textarea",
          "id": "subheading",
          "label": "Description",
          "default": "Employee service awards, client gifts and executive gifts — each engraved with the recipient's name, made in our Plano studio, and proofed before production."
        },
        {
          "type": "textarea",
          "id": "body_text",
          "label": "Body text",
          "default": "Get a FREE custom mockup before you order."
        },
        {
          "type": "checkbox",
          "id": "bulk_quote",
          "label": "Highlight primary bulk quote button",
          "default": false
        },
        {
          "type": "text",
          "id": "primary_cta_text",
          "label": "Primary button text",
          "default": "Get a Free Mockup"
        },
        {
          "type": "url",
          "id": "primary_cta_url",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_cta_text",
          "label": "Secondary button text",
          "default": "See Pricing"
        },
        {
          "type": "url",
          "id": "secondary_cta_url",
          "label": "Secondary button link",
          "default": "/collections/all"
        },
        {
          "type": "text",
          "id": "badge_title",
          "label": "Image badge title",
          "default": "Produced In-House"
        },
        {
          "type": "textarea",
          "id": "badge_text",
          "label": "Image badge text",
          "default": "In-house laser engraving · Dallas, Texas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — photos & video",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "limit": 1,
  "enabled_on": {
    "templates": [
      "index"
    ]
  }
}
{% endschema %}
