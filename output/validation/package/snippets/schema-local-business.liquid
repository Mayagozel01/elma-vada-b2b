{% capture business_json %}
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": {{ shop.url | append: '#localbusiness' | json }},
  "name": {{ settings.business_name | default: 'Elma Vada Studio' | json }},
  "url": {{ shop.url | json }},
  "email": {{ settings.business_email | default: 'daria@elmavada.com' | json }},
  "description": "Personalized corporate gifts and in-house laser engraving in Dallas–Fort Worth. Orders from 1 to 5,000+ units.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ settings.business_street | default: '18383 Preston Rd, #202' | json }},
    "addressLocality": {{ settings.business_city | default: 'Dallas' | json }},
    "addressRegion": {{ settings.business_region | default: 'TX' | json }},
    "postalCode": {{ settings.business_postcode | default: '75252' | json }},
    "addressCountry": "US"
  },
  "areaServed": {{ settings.business_area | default: 'Dallas–Fort Worth' | json }}
  {% if settings.business_phone != blank %},"telephone": {{ settings.business_phone | json }}{% endif %}
  {% if settings.business_image != blank %},"image": {{ settings.business_image | image_url: width: 1600 | prepend: 'https:' | json }}{% endif %}
  {% if settings.social_instagram != blank or settings.social_etsy != blank %}
  ,"sameAs": [
    {% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}
    {% if settings.social_instagram != blank and settings.social_etsy != blank %},{% endif %}
    {% if settings.social_etsy != blank %}{{ settings.social_etsy | json }}{% endif %}
  ]
  {% endif %}
}

{% endcapture %}
<script type="application/ld+json">{{ business_json | replace: '</script', '<\\/script' }}</script>
