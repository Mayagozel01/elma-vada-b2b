{% if settings.enable_cart_gift_offers %}
  {% capture candidates %}{% render 'gift-offer-candidates', cart: cart %}{% endcapture %}
  <div class="cart-gift-offers" data-cart-offers data-cart-url="{{ routes.cart_url }}" data-add-url="{{ routes.cart_add_url }}.js"
    data-auto-open="{% if settings.auto_open_cart_gift_offers == false %}false{% else %}true{% endif %}" data-delay="{{ settings.cart_gift_offers_delay | default: 5 }}">
    <template data-offer-candidates>{{ candidates }}</template>
    <section class="gift-offers" data-offers-panel aria-labelledby="CartGiftOffersHeading" {% if candidates == blank %}hidden{% endif %}>
      <div class="gift-offers__heading"><h2 id="CartGiftOffersHeading">Complete your gift</h2><button type="button" class="gift-offers-open" data-offers-open aria-haspopup="dialog" aria-controls="CartGiftOffersDialog" hidden>View gift offers</button></div>
      <p class="commerce-note">Selected to complement your order.</p>
      <div class="gift-offers-grid" data-offers-list>{% render 'gift-offer-candidates', cart: cart, limit: 3 %}</div>
      <noscript><p class="commerce-note">Enable JavaScript to add these extras from your cart.</p></noscript>
    </section>
    <p class="commerce-message" data-offers-status role="status" tabindex="-1" hidden></p>
    <dialog class="gift-offers-dialog" id="CartGiftOffersDialog" data-offers-dialog aria-labelledby="CartGiftOffersTitle" aria-describedby="CartGiftOffersDescription">
      <div class="gift-offers-dialog__header"><h2 id="CartGiftOffersTitle">Complete your gift</h2><button type="button" class="gift-offers-dialog__close" data-offers-close aria-label="Close gift offers" autofocus>×</button></div>
      <div class="gift-offers-dialog__body">
        <p class="commerce-note" id="CartGiftOffersDescription">Selected to complement your order.</p>
        <div data-offers-list></div>
        <p class="commerce-message" data-dialog-status role="status" hidden></p>
      </div>
      <div class="gift-offers-dialog__footer"><button type="button" class="btn btn--outline" data-offers-close>Continue to cart</button></div>
    </dialog>
  </div>
{% endif %}
