    "questions": {
      "type": "b2b-faq",
      "settings": {
        "heading": "What else would you like to know?"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "What information should I send for a quote?",
            "answer": "<p>Share the occasion, estimated quantity, target date, delivery location and any artwork you already have. A budget range helps narrow the options.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can every gift have a different name?",
            "answer": "<p>Include personalization requirements in your request. We will confirm the suitable product, method and recipient-list format for the project.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Can I review a mockup or sample first?",
            "answer": "<p>Ask about digital mockup and physical sample options. Availability, cost and timing are confirmed for your project before you commit.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How long will my order take?",
            "answer": "<p>Timing depends on product availability, quantity, artwork approval and fulfillment. Your quote will set out the proposed schedule; please share any fixed event date.</p>"
          }
        }
      },
