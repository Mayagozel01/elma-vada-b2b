<section class="section bg-navy" id="BusinessSolutions"><div class="container">
  <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;"><h2 class="section-title" style="color: #fff;">{{ section.settings.heading }}</h2><p class="section-subtitle" style="color: rgba(255,255,255,0.7); font-size: 1.125rem;">{{ section.settings.subheading }}</p></div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
    {%- for block in section.blocks -%}<div class="card" {{ block.shopify_attributes }} style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 2rem;"><h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: #fff; margin-bottom: 0.75rem;">{{ block.settings.title }}</h3><p style="color: rgba(255,255,255,0.6); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;">{{ block.settings.text }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" style="color: var(--color-gold); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">{{ block.settings.link_label }} →</a>{% endif %}</div>{%- endfor -%}
  </div>
</div></section>
{% schema %}
{"name":"Business Solutions","settings":[{"type":"text","id":"heading","label":"Heading","default":"Business Solutions"},{"type":"textarea","id":"subheading","label":"Subheading","default":"We don’t sell individual products. We deliver complete business solutions."}],"blocks":[{"type":"solution","name":"Solution card","settings":[{"type":"text","id":"title","label":"Title","default":"Corporate Gifts"},{"type":"textarea","id":"text","label":"Description","default":"Premium engraved products for your business."},{"type":"text","id":"link_label","label":"Link label","default":"Explore service"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Business Solutions","blocks":[{"type":"solution","settings":{"title":"Corporate Gifts","text":"Premium engraved drinkware, pens, and desk accessories for executives and VIPs.","link_label":"Explore corporate gifts"}},{"type":"solution","settings":{"title":"Employee Appreciation","text":"Meaningful, personalized gear to recognize milestones and reward your team.","link_label":"Explore merchandise"}},{"type":"solution","settings":{"title":"Client Gifts","text":"Memorable branded merchandise that keeps your company top-of-mind.","link_label":"Explore corporate gifts"}},{"type":"solution","settings":{"title":"Event Merchandise","text":"High-volume, consistent-quality gifts for trade shows and events.","link_label":"Explore promotional products"}},{"type":"solution","settings":{"title":"Branded Onboarding Kits","text":"Cohesive, personalized welcome boxes for new hires.","link_label":"Explore merchandise"}},{"type":"solution","settings":{"title":"Promotional Products","text":"Accessories and products branded with precision and speed.","link_label":"Explore promotional products"}}]}]}
{% endschema %}
