<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1E252B">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {% render 'seo-meta' %}

    {% render 'local-fonts' %}

    {{ content_for_header }}

    {% render 'schema-local-business' %}
    {% render 'tracking' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'b2b-pages.css' | asset_url | stylesheet_tag }}
    {{ 'revision.css' | asset_url | stylesheet_tag }}
    {{ 'bonus-popup.css' | asset_url | stylesheet_tag }}
    {% if template.name == 'page' and template.suffix == 'book-a-call' %}
      {{ 'office-visit.css' | asset_url | stylesheet_tag }}
      {{ 'callback-request.css' | asset_url | stylesheet_tag }}
      <script>
        document.documentElement.dataset.consultation = new URLSearchParams(location.search).get('request') === 'in-person' || location.hash === '#OfficeVisitForm' || location.hash === '#OfficeVisitStatus' ? 'office' : 'call';
      </script>
      <script src="{{ 'office-visit.js' | asset_url }}" defer></script>
    {% endif %}
    {% if template.name == 'collection' or template.name == 'product' or template.name == 'cart' %}
      {{ 'commerce.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if request.page_type == 'page' and page.handle == 'our-work' %}
<script>
(() => {
  const phrase = 'the pens were more than what i expected';

  function patch(utils) {
    if (!utils || typeof utils.getReviews !== 'function') return utils;
    if (utils.getReviews.elmaFiltered) return utils;

    const original = utils.getReviews;

    async function filteredReviews(params, settings) {
      const reviews = await original.call(this, params, settings);

      if (params.carousel_type !== 'cards' || !Array.isArray(reviews)) {
        return reviews;
      }

      return reviews.filter(review => {
        const html = String(review.body_html || review.body || '');
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const text = (doc.body.textContent || '')
          .replace(/\s+/g, ' ')
          .trim()
          .toLowerCase();

        return !text.includes(phrase);
      });
    }

    filteredReviews.elmaFiltered = true;
    utils.getReviews = filteredReviews;
    return utils;
  }

  if (window.jdgmCarouselUtils) {
    patch(window.jdgmCarouselUtils);
  } else {
    Object.defineProperty(window, 'jdgmCarouselUtils', {
      configurable: true,
      enumerable: true,
      get() {
        return undefined;
      },
      set(value) {
        Object.defineProperty(window, 'jdgmCarouselUtils', {
          value: patch(value),
          writable: true,
          configurable: true,
          enumerable: true
        });
      }
    });
  }
})();
</script>
{% endif %}
  </head>

  <body class="page-{{ template.name }}{% if template.suffix %}-{{ template.suffix }}{% endif %}">

    {% section 'header' %}

    <main id="MainContent" class="content-for-layout">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'revision.js' | asset_url }}" defer></script>
    <script src="{{ 'bonus-popup.js' | asset_url }}" defer></script>
    {% if template.name == 'product' %}<script src="{{ 'commerce.js' | asset_url }}" defer></script>{% endif %}
  </body>
</html>
