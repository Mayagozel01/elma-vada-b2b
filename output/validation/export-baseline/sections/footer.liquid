{%- assign services_menu = section.settings.services_menu -%}
{%- assign company_menu = section.settings.company_menu -%}
<footer class="site-footer" role="contentinfo">
  <div class="container">

    <div class="footer__grid">

      <!-- Brand col -->
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name }}">
          {% if section.settings.logo_image != blank %}
            <img class="ev-brand-logo ev-brand-logo--footer"
              src="{{ section.settings.logo_image | image_url: width: 900 }}"
              alt="{{ section.settings.logo_image.alt | default: shop.name | escape }}"
              width="{{ section.settings.logo_image.width }}" height="{{ section.settings.logo_image.height }}"
              style="--logo-width: {{ section.settings.logo_width | default: 220 }}px;"
              loading="lazy">
          {% else %}
          <div class="footer__logo-badge">EV</div>
          <div>
            <div class="footer__logo-name">Elma Vada Studio</div>
          </div>
          {% endif %}
        </a>
        <p class="footer__tagline">
          {{ section.settings.tagline | default: 'Personalized corporate gifts and in-house laser engraving in Dallas–Fort Worth. From individual gifts to orders of 5,000+ units.' }}
        </p>
        <a href="/pages/request-a-quote" class="btn btn--gold" style="align-self: flex-start; margin-top: var(--space-2);">
          Request a Quote
        </a>
      </div>

      <!-- Solutions col -->
      <div>
        <div class="footer__col-title">Solutions</div>
        <ul class="footer__links">
          {% if services_menu != blank %}
            {% for link in services_menu.links %}{% unless link.url contains 'etsy.com' %}<li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>{% endunless %}{% endfor %}
          {% else %}
          <li><a href="/pages/corporate-gifts" class="footer__link">Corporate Gifts</a></li>
          <li><a href="/pages/bulk-orders" class="footer__link">Bulk Orders</a></li>
          <li><a href="/pages/branded-merchandise" class="footer__link">Personalized Merchandise</a></li>
          <li><a href="/pages/custom-engraving" class="footer__link">Custom Engraving</a></li>
          <li><a href="/pages/promotional-products" class="footer__link">Promotional Products</a></li>
          <li><a href="/pages/client-gifting" class="footer__link">Client Gifting</a></li>
          <li><a href="/pages/service-awards" class="footer__link">Service Awards</a></li>
          <li><a href="/pages/employee-recognition" class="footer__link">Employee Recognition</a></li>
          <li><a href="/pages/events-awards" class="footer__link">Events & Awards</a></li>
          <li><a href="/pages/onboarding" class="footer__link">Onboarding Gifts</a></li>
          <li><a href="/pages/milestone-program" class="footer__link">Milestone Program</a></li>
          <li><a href="/pages/faq" class="footer__link">FAQ</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Company col -->
      <div>
        <div class="footer__col-title">Company</div>
        <ul class="footer__links">
          {% if company_menu != blank %}
            {% for link in company_menu.links %}{% unless link.url contains 'etsy.com' %}<li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>{% endunless %}{% endfor %}
          {% else %}
          <li><a href="/pages/business-solutions" class="footer__link">Business Solutions</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="footer__link">Shop Products</a></li>
          <li><a href="/pages/about" class="footer__link">About Our Studio</a></li>
          <li><a href="/pages/production-capabilities" class="footer__link">Capabilities</a></li>
          <li><a href="/pages/industries" class="footer__link">Industries We Serve</a></li>
          <li><a href="/pages/our-work" class="footer__link">Portfolio / Our Work</a></li>
          <li><a href="/pages/request-a-quote" class="footer__link">Request a Quote</a></li>
          <li><a href="/pages/free-mockup" class="footer__link">Get a Free Mockup</a></li>
          <li><a href="/pages/book-a-call" class="footer__link">Schedule a Consultation</a></li>
          <li><a href="/policies/privacy-policy" class="footer__link">Privacy Policy</a></li>
          {% endif %}
        </ul>
      </div>

      <!-- Contact col -->
      <div>
        <div class="footer__col-title">Contact</div>

        <div class="footer__contact-item">
          <span class="footer__contact-label">Email</span>
          <a href="mailto:{{ settings.business_email | default: 'daria@elmavada.com' }}" class="footer__contact-value footer__link">
            {{ settings.business_email | default: 'daria@elmavada.com' }}
          </a>
        </div>

        {% if settings.business_phone != blank %}
          <div class="footer__contact-item">
            <span class="footer__contact-label">Phone</span>
            <a href="tel:{{ settings.business_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}" class="footer__contact-value footer__link">{{ settings.business_phone }}</a>
          </div>
        {% endif %}

        <div class="footer__contact-item">
          <span class="footer__contact-label">Location</span>
          <span class="footer__contact-value">{% render 'business-address' %}<br>{{ settings.business_area | default: 'Dallas–Fort Worth' | escape }}</span>
        </div>

        {% if settings.business_hours != blank %}
          <div class="footer__contact-item">
            <span class="footer__contact-label">Hours</span>
            <span class="footer__contact-value">{{ settings.business_hours }}</span>
          </div>
        {% endif %}

        <div class="footer__contact-item">
          <span class="footer__contact-label">Orders</span>
          <span class="footer__contact-value">{{ section.settings.orders_line_one | default: '1–5,000+ Units' }}<br>{{ section.settings.orders_line_two | default: 'Local & Nationwide Shipping' }}</span>
        </div>

        {% render 'contact-links' %}
        <!-- Social -->
        <div style="display: flex; gap: var(--space-3); margin-top: var(--space-6);">

          {% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}" class="footer__link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>{% endif %}
        </div>
      </div>

    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} Elma Vada Studio. All rights reserved. Local DFW production studio.
      </p>
      <div style="display: flex; gap: var(--space-6);">
        <a href="/policies/terms-of-service" class="footer__link" style="font-size: var(--fs-xs);">Terms</a>
        <a href="/policies/privacy-policy" class="footer__link" style="font-size: var(--fs-xs);">Privacy</a>
        <a href="/policies/shipping-policy" class="footer__link" style="font-size: var(--fs-xs);">Shipping</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Choose a logo for the dark footer, for example a light version with a transparent background."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Personalized corporate gifts and in-house laser engraving in Dallas–Fort Worth. From individual gifts to orders of 5,000+ units."
    },
    {
      "type": "link_list",
      "id": "services_menu",
      "label": "Services menu"
    },
    {
      "type": "link_list",
      "id": "company_menu",
      "label": "Company menu"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "daria@elmavada.com",
      "info": "Contact display now uses Theme settings → Business & contact. This legacy value is preserved."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "info": "Contact display now uses Theme settings → Business & contact. This legacy value is preserved."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Dallas, Texas",
      "info": "Contact display now uses Theme settings → Business & contact. This legacy value is preserved."
    },
    {
      "type": "text",
      "id": "service_area",
      "label": "Service area",
      "default": "Dallas–Fort Worth Area",
      "info": "Contact display now uses Theme settings → Business & contact. This legacy value is preserved."
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "placeholder": "Mon–Fri, 9 AM–6 PM",
      "info": "Contact display now uses Theme settings → Business & contact. This legacy value is preserved."
    },
    {
      "type": "text",
      "id": "orders_line_one",
      "label": "Orders line one",
      "default": "1–5,000+ Units"
    },
    {
      "type": "text",
      "id": "orders_line_two",
      "label": "Orders line two",
      "default": "Local & Nationwide Shipping"
    }
  ]
}
{% endschema %}
