<section class="section bg-beige" id="Capabilities">
  <div class="container">
    <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;">
      <h2 class="section-title">Production Capabilities</h2>
      <p class="section-subtitle" style="color: var(--color-text-secondary); font-size: 1.125rem;">
        Multi-material precision production under one roof.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">
      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">UV Printing</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Full-color, photo-quality direct printing on virtually any flat surface or promotional item.</p>
      </div>

      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">CO₂ Laser Engraving</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Precision etching and cutting on organic materials, plastics, and coated metals.</p>
      </div>

      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">Fiber Laser Engraving</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Permanent, high-contrast marking strictly for raw metals, stainless steel, and aluminum.</p>
      </div>

      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">Glass Engraving</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Elegant frosting and deep etching for awards, glassware, and crystal pieces.</p>
      </div>

      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">Acrylic, Metal, Wood, Leather</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Versatile production scaling across diverse raw materials to match your brand's aesthetic.</p>
      </div>

      <div style="background: #fff; padding: 2rem; border-top: 3px solid var(--color-gold);">
        <h3 style="font-family: var(--font-heading); font-size: 1.4rem; color: var(--color-navy); margin-bottom: 0.5rem;">Promotional Products & Branding</h3>
        <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">Complete sourcing and branding for highly customized, volume-based merch orders.</p>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3rem;">
      <a href="/pages/production-capabilities" class="btn btn--outline" style="border-color: var(--color-navy); color: var(--color-navy);">View Full Production Capabilities</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Production Capabilities",
  "presets": [{"name": "Production Capabilities"}]
}
{% endschema %}
