{% liquid
  assign show_primary = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign show_primary = true
  endif
  assign show_secondary = false
  if section.settings.secondary_label != blank and section.settings.secondary_link != blank
    assign show_secondary = true
  endif
%}
<section class="b2b-section b2b-section--{{ section.settings.color_scheme }}">
  <div class="container b2b-split b2b-hero{% if section.settings.image == blank and request.design_mode == false %} b2b-split--text-only{% endif %}">
    <div>
      {% if section.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
      <div class="b2b-rte">{{ section.settings.text }}</div>
      {% if show_primary or show_secondary %}
        <div class="b2b-actions">
          {% if show_primary %}<a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>{% endif %}
          {% if show_secondary %}<a class="btn btn--outline" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        </div>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <ul class="procurement-hero__highlights">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
    {% render 'b2b-image', photo: section.settings.image, alt: section.settings.image_alt, title: section.settings.heading, note: section.settings.photo_note, eager: true %}
  </div>
</section>

{% stylesheet %}
  .procurement-hero__highlights { display: flex; flex-wrap: wrap; gap: .6rem; margin: 1.4rem 0 0; padding: 0; list-style: none; }
  .procurement-hero__highlights li { padding: .4rem .8rem; border: 1px solid var(--color-beige-dark); background: var(--color-white); color: var(--color-navy); font-size: .9rem; font-weight: 600; line-height: 1.4; }
  .b2b-split--text-only .procurement-hero__highlights { justify-content: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Procurement hero",
  "tag": "div",
  "limit": 1,
  "enabled_on": {"templates": ["page"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading (H1)"},
    {"type": "richtext", "id": "text", "label": "Introduction"},
    {"type": "image_picker", "id": "image", "label": "Hero photo", "info": "Optional. Upload a real Elma Vada photo, ideally 4:3 or square, and keep the original engraving and product details. Without a photo the text is centered."},
    {"type": "text", "id": "image_alt", "label": "Photo description (alt)"},
    {"type": "textarea", "id": "photo_note", "label": "Photo brief (editor only)"},
    {"type": "text", "id": "button_label", "label": "Primary button"},
    {"type": "url", "id": "button_link", "label": "Primary link"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button"},
    {"type": "url", "id": "secondary_link", "label": "Secondary link"},
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Background",
      "options": [
        {"value": "cream", "label": "Cream"},
        {"value": "navy", "label": "Dark"},
        {"value": "white", "label": "White"}
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {"type": "text", "id": "text", "label": "Text", "default": "Short benefit"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name": "Procurement hero"}]
}
{% endschema %}
