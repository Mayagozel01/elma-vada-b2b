{% if template.name == 'page' and template.suffix == 'book-a-call' %}
<section class="b2b-section b2b-section--cream office-visit" data-office-visit>
  <div class="container">
    <div class="office-visit__header">
      <h1>{{ section.settings.heading | escape }}</h1>
      <div class="b2b-rte">{{ section.settings.text }}</div>
    </div>
    <p class="office-visit__note">Office visits are arranged by appointment in Dallas–Fort Worth. Your preferred date and time are requests, not a confirmed booking.</p>
    {% if section.blocks.size > 0 %}
      <div class="ev-shopify-form" data-shopify-office-form>
        {% for block in section.blocks %}{% render block %}{% endfor %}
      </div>
    {% else %}
      {% comment %}Let Shopify manage the contact redirect and server result; do not override it with a fixed return_to.{% endcomment %}
      {% form 'contact', id: 'OfficeVisitForm' %}
        {% if form.posted_successfully? %}
          <div id="OfficeVisitStatus" class="office-visit__status" role="status" tabindex="-1" autofocus data-office-status>
            {{ section.settings.success_message | escape }}
          </div>
        {% else %}
          {% if form.errors %}
            <div id="OfficeVisitStatus" class="office-visit__status office-visit__status--error" role="alert" tabindex="-1" autofocus data-office-status>
              <p>Please review the errors and send your request again.</p>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <input type="hidden" name="contact[Request type]" value="Office visit — Dallas–Fort Worth">
          <input type="hidden" name="contact[State]" value="Texas">
          <input type="hidden" name="contact[Country]" value="United States">
          <input type="hidden" name="contact[Appointment status]" value="Requested — awaiting location and appointment confirmation">
          <p class="office-visit__note">Fields marked * are required.</p>
          <div class="office-visit__fields">
            <div class="office-visit__field">
              <label for="OfficeName">Contact name *</label>
              <input id="OfficeName" name="contact[name]" type="text" autocomplete="name" required value="{{ form.name | default: customer.name | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeCompany">Company name *</label>
              <input id="OfficeCompany" name="contact[Company name]" type="text" autocomplete="organization" required value="{{ form['Company name'] | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeEmail">Email *</label>
              <input id="OfficeEmail" name="contact[email]" type="email" autocomplete="email" autocapitalize="off" required value="{{ form.email | default: customer.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
            </div>
            <div class="office-visit__field">
              <label for="OfficePhone">Phone</label>
              <input id="OfficePhone" name="contact[phone]" type="tel" autocomplete="tel" value="{{ form.phone | escape }}">
            </div>
            <div class="office-visit__field office-visit__field--wide">
              <label for="OfficeAddress">Office address (street, building and suite) *</label>
              <input id="OfficeAddress" name="contact[Office address]" type="text" autocomplete="street-address" required value="{{ form['Office address'] | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeCity">City *</label>
              <input id="OfficeCity" name="contact[City]" type="text" autocomplete="address-level2" required value="{{ form['City'] | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeZip">ZIP code *</label>
              <input id="OfficeZip" name="contact[ZIP code]" type="text" autocomplete="postal-code" required pattern="[0-9]{5}(-[0-9]{4})?" title="Enter a 5-digit ZIP code or ZIP+4, for example 75201 or 75201-1234." value="{{ form['ZIP code'] | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeDate">Preferred date</label>
              <input id="OfficeDate" name="contact[Preferred date]" type="date" value="{{ form['Preferred date'] | escape }}">
            </div>
            <div class="office-visit__field">
              <label for="OfficeAvailability">Preferred time or availability</label>
              <input id="OfficeAvailability" name="contact[Preferred time or availability]" type="text" placeholder="Weekdays, 10 am–2 pm Central" value="{{ form['Preferred time or availability'] | escape }}">
            </div>
            <div class="office-visit__field office-visit__field--wide">
              <label for="OfficeDetails">Project details</label>
              <textarea id="OfficeDetails" name="contact[body]" rows="5">{{ form.body | escape }}</textarea>
            </div>
          </div>
          <p class="office-visit__note">{{ section.settings.confirmation_note | escape }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a></p>
          <button type="submit" class="btn btn--primary">{{ section.settings.button_label | escape }}</button>
        {% endif %}
      {% endform %}
    {% endif %}
    <p class="office-visit__note">Prefer a call? <a href="{{ routes.root_url }}pages/book-a-call?request=call">Request a project call</a>.</p>
    <noscript><p class="office-visit__note">Use this form for an office visit. The separate project call form is also available below.</p></noscript>
    {% if request.design_mode and section.blocks.size == 0 %}<p class="b2b-editor-note">Using Shopify’s native contact form. To use Shopify Forms, create a separate Office Visit inline form in Admin and add its app block here. Do not use quote Form ID 1155185.</p>{% endif %}
  </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Office visit request",
  "limit": 1,
  "enabled_on": {"templates": ["page"]},
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Request an Office Visit"},
    {"type": "richtext", "id": "text", "label": "Description", "default": "<p>Tell us where your office is located and when you’re available. Our team will contact you to confirm a visit and discuss your gifting project.</p>"},
    {"type": "text", "id": "button_label", "label": "Native form button", "default": "Request an Office Visit"},
    {"type": "textarea", "id": "success_message", "label": "Native form success message", "default": "Thank you! We’ve received your office visit request. Our team will contact you to confirm the location, date and time."},
    {"type": "textarea", "id": "confirmation_note", "label": "Confirmation note", "default": "Submitting this request does not book an appointment. We’ll contact you to confirm the location, date and time."},
    {"type": "paragraph", "content": "With an app block, configure its fields, submit button, success message and notifications in Shopify Forms, not here."}
  ],
  "blocks": [{"type": "@app"}],
  "max_blocks": 1,
  "presets": [{"name": "Office visit request"}]
}
{% endschema %}
