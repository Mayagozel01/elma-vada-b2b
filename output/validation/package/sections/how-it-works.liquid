<section class="section" style="background: #fff;">
  <div class="container" style="max-width: 900px;">
    <div style="text-align: center; margin-bottom: 3.5rem;">
      <h2 class="section-title">How It Works</h2>
    </div>

    <div style="display: flex; flex-direction: column; gap: 2rem; position: relative;">
      <!-- Timeline line -->
      <div style="position: absolute; left: 19px; top: 10px; bottom: 10px; width: 2px; background: #e1e1e1; z-index: 0;"></div>

      <div style="position: relative; z-index: 1; display: flex; gap: 1.5rem; align-items: flex-start;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">1</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.25rem; color: var(--color-navy);">Send request</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-secondary);">Tell us your quantity, timeline, and rough ideas using our quick online form.</p>
        </div>
      </div>

      <div style="position: relative; z-index: 1; display: flex; gap: 1.5rem; align-items: flex-start;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">2</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.25rem; color: var(--color-navy);">Choose solution & materials</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-secondary);">We help you select the best corporate gifts and exact engraving methods.</p>
        </div>
      </div>

      <div style="position: relative; z-index: 1; display: flex; gap: 1.5rem; align-items: flex-start;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">3</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.25rem; color: var(--color-navy);">Approve digital proof</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-secondary);">Review the final mocked-up design for total accuracy before we touch the machines.</p>
        </div>
      </div>

      <div style="position: relative; z-index: 1; display: flex; gap: 1.5rem; align-items: flex-start;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">4</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.25rem; color: var(--color-navy);">Production</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-secondary);">Our local DFW team processes your entire batch with thorough quality checks.</p>
        </div>
      </div>

      <div style="position: relative; z-index: 1; display: flex; gap: 1.5rem; align-items: flex-start;">
        <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-navy); color: var(--color-gold); display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;">5</div>
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; margin-bottom: 0.25rem; color: var(--color-navy);">Pickup / Delivery / Shipping</h3>
          <p style="margin: 0; font-size: 0.95rem; color: var(--color-text-secondary);">Securely packed and delivered to your office or shipped directly to your clients.</p>
        </div>
      </div>
    </div>

    <div style="text-align: center; margin-top: 3.5rem;">
      <a href="/pages/request-a-quote" class="btn btn--primary">Request a Quote</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "presets": [{"name": "Timeline Steps"}]
}
{% endschema %}
