<!-- 404 page template -->
<div style="background-color: var(--color-cream); min-height: 60vh; display: flex; align-items: center; padding: var(--space-24) 0;">
  <div class="container" style="text-align: center;">
    <span class="eyebrow">Error 404</span>
    <h1 style="font-family: var(--font-heading); font-size: clamp(2.5rem, 6vw, 5rem); color: var(--color-navy); margin-bottom: var(--space-6);">
      Page Not Found
    </h1>
    <p style="font-size: var(--fs-lg); color: var(--color-text-secondary); max-width: 44ch; margin: 0 auto var(--space-10);">
      The page you're looking for doesn't exist. Try starting from the homepage or request a quote.
    </p>
    <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
      <a href="{{ routes.root_url }}" class="btn btn--primary">Back to Home</a>
      <a href="/pages/request-a-quote" class="btn btn--outline">Request a Quote</a>
    </div>
  </div>
</div>
