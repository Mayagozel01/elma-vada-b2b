{% if template.name == 'page' and template.suffix == 'book-a-call' %}
<section class="callback-request b2b-section b2b-section--cream" data-consultation-call>
  <div class="container callback-request__layout">
    <div class="callback-request__intro">
      {% if section.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
    </div>

    <div class="callback-request__panel{% if section.settings.image == blank %} callback-request__panel--no-image{% endif %}">
    <div class="callback-request__form-wrap" tabindex="-1">
      {% comment %}Keep Shopify's native contact redirect so its server result remains available to Liquid.{% endcomment %}
      {% form 'contact', id: 'CallRequestForm' %}
        {% if section.settings.text != blank %}<div class="b2b-rte callback-request__description">{{ section.settings.text }}</div>{% endif %}
        {% if form.posted_successfully? %}
          <div id="CallRequestStatus" class="callback-request__status" role="status" tabindex="-1" autofocus data-call-status>
            {{ section.settings.success_message | escape }}
          </div>
        {% else %}
          {% if form.errors %}
            <div id="CallRequestStatus" class="callback-request__status callback-request__status--error" role="alert" tabindex="-1" autofocus data-call-status>
              <p>Please review the errors and send your request again.</p>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <input type="hidden" name="contact[Request type]" value="Callback request">
          <input type="hidden" name="contact[body]" value="Request type: Callback request">
          <div class="callback-request__fields">
            <div class="callback-request__field">
              <label for="CallRequestName">Name <span aria-hidden="true">*</span></label>
              <input id="CallRequestName" name="contact[name]" type="text" autocomplete="name" required value="{{ form.name | default: customer.name | escape }}">
            </div>
            <div class="callback-request__field">
              <label for="CallRequestPhone">Phone <span aria-hidden="true">*</span></label>
              <input id="CallRequestPhone" name="contact[phone]" type="tel" autocomplete="tel" inputmode="tel" required value="{{ form.phone | default: customer.phone | escape }}">
            </div>
            <div class="callback-request__field callback-request__field--wide">
              <label for="CallRequestEmail">Email <span aria-hidden="true">*</span></label>
              <input id="CallRequestEmail" name="contact[email]" type="email" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{{ form.email | default: customer.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="CallRequestStatus"{% endif %}>
            </div>
            <div class="callback-request__field callback-request__field--wide">
              <label for="CallRequestTime">Preferred time to call</label>
              <input id="CallRequestTime" name="contact[Preferred time to call]" type="text" aria-describedby="CallRequestTimeHint" value="{{ form['Preferred time to call'] | escape }}">
              <p id="CallRequestTimeHint" class="callback-request__hint">{{ section.settings.time_hint | escape }}</p>
            </div>
          </div>
          <button type="submit" class="btn btn--primary">{{ section.settings.button_label | escape }}</button>
          <p class="callback-request__note">{{ section.settings.confirmation_note | escape }}</p>
        {% endif %}
      {% endform %}
    </div>

    {% if section.settings.image != blank %}
      <div class="callback-request__media">
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image_alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      </div>
    {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Request a Call",
  "limit": 1,
  "enabled_on": {"templates": ["page"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elma Vada · Dallas, Texas"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Request a Call"},
    {"type": "richtext", "id": "text", "label": "Description", "default": "<p>Leave your contact details and a convenient time to reach you. Our team will contact you to discuss your project.</p>"},
    {"type": "text", "id": "time_hint", "label": "Time field hint", "default": "Please include your time zone."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Request a Call"},
    {"type": "textarea", "id": "confirmation_note", "label": "Confirmation note", "default": "Submitting this request does not book a confirmed appointment."},
    {"type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you! We’ve received your call request. Our team will contact you using the details you provided."},
    {"type": "image_picker", "id": "image", "label": "Optional photo"},
    {"type": "text", "id": "image_alt", "label": "Photo description (alt)"}
  ],
  "presets": [{"name": "Request a Call"}]
}
{% endschema %}
