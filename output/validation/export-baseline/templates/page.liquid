<!-- Generic page template -->
<div style="background-color: var(--color-cream); padding-top: var(--space-20); padding-bottom: var(--space-24);">
  <div class="container">
    <div style="max-width: 800px; margin: 0 auto;">
      <span class="eyebrow">{{ page.title }}</span>
      <h1 style="font-family: var(--font-heading); font-size: clamp(2rem, 5vw, 3.5rem); color: var(--color-navy); margin-bottom: var(--space-8);">
        {{ page.title }}
      </h1>
      <div class="rte" style="font-size: var(--fs-lg); color: var(--color-text-secondary); line-height: 1.8;">
        {{ page.content }}
      </div>
    </div>
  </div>
</div>
