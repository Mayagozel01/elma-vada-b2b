{% if template.name == 'page' and template.suffix == 'book-a-call' %}
{% liquid
  assign booking_url = section.settings.booking_url | strip
  assign booking_embed_url = booking_url
  if booking_embed_url != blank
    if booking_embed_url contains 'gv=true'
      assign booking_embed_url = booking_embed_url
    elsif booking_embed_url contains '?'
      assign booking_embed_url = booking_embed_url | append: '&gv=true'
    else
      assign booking_embed_url = booking_embed_url | append: '?gv=true'
    endif
  endif
%}
<section class="callback-request b2b-section b2b-section--cream" data-consultation-call>
  <div class="container callback-request__layout">
    <div class="callback-request__intro">
      {% if section.settings.eyebrow != blank %}<p class="b2b-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
    </div>

    <div class="callback-request__panel{% if section.settings.image == blank %} callback-request__panel--no-image{% endif %}">
    <div class="callback-request__form-wrap" tabindex="-1">
      {% if section.settings.text != blank %}<div class="b2b-rte callback-request__description">{{ section.settings.text }}</div>{% endif %}
      <div id="CallRequestForm" class="callback-request__booking" aria-label="{{ section.settings.booking_frame_title | escape }}">
        {% if booking_embed_url != blank %}
          <iframe
            src="{{ booking_embed_url | escape }}"
            title="{{ section.settings.booking_frame_title | escape }}"
            loading="lazy"
            allowfullscreen>
          </iframe>
        {% else %}
          {% if request.design_mode %}<p class="b2b-editor-note">Paste the public Google Appointment Schedule link in the “Google booking schedule” setting.</p>{% endif %}
          {% if section.settings.booking_fallback_label != blank and section.settings.booking_fallback_url != blank %}
            <a class="btn btn--primary" href="{{ section.settings.booking_fallback_url }}" target="_blank" rel="noopener noreferrer">{{ section.settings.booking_fallback_label | escape }}</a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.image != blank %}
      <div class="callback-request__media">
        <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image_alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
      </div>
    {% endif %}
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Request a Call",
  "limit": 1,
  "enabled_on": {"templates": ["page"]},
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Elma Vada · Dallas, Texas"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Request a Call"},
    {"type": "richtext", "id": "text", "label": "Description", "default": "<p>Select a time that works for you, then enter your contact details and discussion topic in the booking form.</p>"},
    {"type": "header", "content": "Google booking schedule"},
    {"type": "text", "id": "booking_url", "label": "Google Appointment Schedule URL", "info": "Paste the public Google Calendar booking link. The booking form, confirmation and reminders are managed in Google Calendar."},
    {"type": "text", "id": "booking_frame_title", "label": "Booking form title", "default": "Book a 15-minute consultation with Elma Vada"},
    {"type": "text", "id": "booking_fallback_label", "label": "Fallback link label", "default": "Open booking calendar"},
    {"type": "url", "id": "booking_fallback_url", "label": "Fallback link URL"},
    {"type": "image_picker", "id": "image", "label": "Optional photo"},
    {"type": "text", "id": "image_alt", "label": "Photo description (alt)"}
  ],
  "presets": [{"name": "Request a Call"}]
}
{% endschema %}
