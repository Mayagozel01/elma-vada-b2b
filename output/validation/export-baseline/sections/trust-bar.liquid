<section class="ev-trust" aria-label="Marketplace recognition">
  <div class="container ev-trust__inner">
    {% if section.settings.etsy_badge %}<span>Etsy Star Seller</span>{% endif %}
    {% if section.settings.ebay_badge %}<span>eBay Top Rated</span>{% endif %}
    {% if section.settings.amazon_product_url != blank %}<a href="{{ section.settings.amazon_product_url }}" target="_blank" rel="noopener">Amazon’s Choice — selected product</a>{% endif %}
    {% if section.settings.review_label != blank and section.settings.review_label != 'Marketplace reviews' and section.settings.review_detail != 'Add verified rating and order count' %}
      <span>{{ section.settings.review_label | escape }}{% if section.settings.review_detail != blank %} · {{ section.settings.review_detail | escape }}{% endif %}</span>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Trust Bar","settings":[
{"type":"checkbox","id":"etsy_badge","label":"Show Etsy Star Seller (keep current)","default":true},
{"type":"checkbox","id":"ebay_badge","label":"Show eBay Top Rated (keep current)","default":true},
{"type":"url","id":"amazon_product_url","label":"Amazon’s Choice product URL","info":"Shown only with a link to the qualifying product. Keep its status current."},
{"type":"text","id":"review_label","label":"Optional verified review headline"},
{"type":"text","id":"review_detail","label":"Optional verified review details"},
{"type":"url","id":"review_url","label":"Legacy review URL (retained)"}],"presets":[{"name":"Trust Bar"}]}
{% endschema %}
